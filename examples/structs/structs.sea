--
-- Structs e Arrays Tipados em Sea
--
-- Demonstra:
--   - Struct literal {k=v,...}: acesso, atualização, iteração, métodos
--   - int_array / float_array: arrays tipados sem RC por elemento
--

print("╔══════════════════════════════════════════╗")
print("║   Structs e Arrays Tipados em Sea        ║")
print("╚══════════════════════════════════════════╝")
print("")

-- ── 1. Struct básico ──────────────────────────────────────────────────────────
print("── 1. Struct básico ─────────────────────────")

local p = { x = 3.0, y = 4.0, nome = "ponto" }
print("  type: " .. type(p))          -- struct
print("  p.x  = " .. p.x)
print("  p.y  = " .. p.y)
print("  p[\"nome\"] = " .. p["nome"])  -- acesso por string

-- Atualização de campos
p.x = 6.0
p["y"] = 8.0
print("  após p.x=6, p.y=8:")
print("    magnitude = " .. math.sqrt(p.x * p.x + p.y * p.y))  -- 10.0
print("  len(p) = " .. len(p))        -- 3 campos
print("")

-- ── 2. Iteração sobre struct ──────────────────────────────────────────────────
print("── 2. Iteração sobre struct ─────────────────")

local config = { host = "localhost", port = 8080, debug = true }
local pares = []
for k, v in config do
    pares[] = "    " .. k .. " = " .. tostring(v)
end
-- ordena para output determinístico
for i = 0, len(pares) - 2 do
    for j = i + 1, len(pares) - 1 do
        if pares[i] > pares[j] then
            local tmp = pares[i]; pares[i] = pares[j]; pares[j] = tmp
        end
    end
end
for i = 0, len(pares) - 1 do print(pares[i]) end
print("")

-- ── 3. Struct como "objeto" (closure sobre self) ──────────────────────────────
print("── 3. Struct como objeto ────────────────────")

local function new_vetor(x, y)
    local self
    self = {
        x = x, y = y,
        escalar = function(f)
            self.x = self.x * f
            self.y = self.y * f
        end,
        magnitude = function()
            return math.sqrt(self.x * self.x + self.y * self.y)
        end,
        string = function()
            return "(" .. self.x .. ", " .. self.y .. ")"
        end,
    }
    return self
end

local v = new_vetor(3.0, 4.0)
print("  v = " .. v.string())
print("  |v| = " .. v.magnitude())   -- 5
v.escalar(2)
print("  v * 2 = " .. v.string())
print("  |v*2| = " .. v.magnitude()) -- 10
print("")

-- ── 4. int_array — array tipado de int64 ──────────────────────────────────────
print("── 4. int_array ─────────────────────────────")

local ia = int_array(8)
for i = 1, 10 do
    ia[] = i * i   -- quadrados de 1 a 10
end
print("  type: " .. type(ia))
print("  len:  " .. len(ia))          -- 10
print("  ia[0] = " .. ia[0])          -- 1
print("  ia[9] = " .. ia[9])          -- 100
print("  ia[-1] = " .. ia[-1])        -- 100 (último)
print("  ia[-2] = " .. ia[-2])        -- 81

-- soma via int_array
local soma = 0
for i = 0, len(ia) - 1 do
    soma = soma + ia[i]
end
print("  soma i² (1..10) = " .. soma)  -- 385
print("")

-- ── 5. float_array — array tipado de float64 ──────────────────────────────────
print("── 5. float_array ───────────────────────────")

local N = 1000
local fa = float_array(N)
for i = 0, N - 1 do
    fa[] = math.sin(i * math.pi / N)
end
print("  type: " .. type(fa))
print("  len:  " .. len(fa))
print("  fa[0]   = " .. fa[0])           -- 0.0
print("  fa[500] ≈ " .. math.floor(fa[500] * 1000) / 1000)  -- ≈ 1.0

-- soma numérica de alta performance
local total = 0.0
for i = 0, len(fa) - 1 do
    total = total + fa[i]
end
print("  soma sin(0..π) ≈ " .. math.floor(total * 100) / 100)  -- ≈ 636.62
print("")

print("── Resumo ───────────────────────────────────")
print("  {k=v,...}     → struct (layout fixo, for-in, métodos via closure)")
print("  int_array(n)  → int64[] sem RC, acesso O(1)")
print("  float_array(n)→ float64[] sem RC, ideal para arrays numéricos")
