--
-- Operações de String em Sea
--
-- Demonstra:
--   - Manipulação por bytes (byte/char)
--   - string.format com todos os especificadores
--   - Padding, replace, normalize_ws
--   - Parser CSV simples com split/trim
--

print("╔══════════════════════════════════════════╗")
print("║      Operações de String em Sea          ║")
print("╚══════════════════════════════════════════╝")
print("")

-- ── 1. Bytes e caracteres ─────────────────────────────────────────────────────
print("── 1. Bytes e caracteres ────────────────────")

local s = "Sea"
print("  'Sea': len=" .. len(s))
print("  byte(1)=" .. string.byte(s, 1) ..   -- 83 = 'S'
      "  byte(2)=" .. string.byte(s, 2) ..   -- 101 = 'e'
      "  byte(3)=" .. string.byte(s, 3))      -- 97 = 'a'

-- Reconstrói a string de bytes
local chars = []
for i = 1, len(s) do
    chars[] = string.char(string.byte(s, i))
end
print("  reconstruído: " .. string.join(chars, ""))

-- ROT13 via byte manipulation
local function rot13(str)
    local out = []
    for i = 1, len(str) do
        local b = string.byte(str, i)
        if b >= 65 and b <= 90 then        -- A-Z
            b = (b - 65 + 13) % 26 + 65
        elseif b >= 97 and b <= 122 then   -- a-z
            b = (b - 97 + 13) % 26 + 97
        end
        out[] = string.char(b)
    end
    return string.join(out, "")
end

local msg = "Hello, Sea!"
print("  ROT13('" .. msg .. "') = " .. rot13(msg))
print("  ROT13 duplo    = " .. rot13(rot13(msg)))   -- volta ao original
print("")

-- ── 2. string.format ──────────────────────────────────────────────────────────
print("── 2. string.format ─────────────────────────")

print("  %d  : " .. string.format("%d", 42))
print("  %05d: " .. string.format("%05d", 42))          -- 00042
print("  %+d : " .. string.format("%+d", 42))           -- +42
print("  %x  : " .. string.format("%x", 255))           -- ff
print("  %X  : " .. string.format("%X", 255))           -- FF
print("  %08x: " .. string.format("%08x", 255))         -- 000000ff
print("  %f  : " .. string.format("%f", math.pi))       -- 3.141593
print("  %.2f: " .. string.format("%.2f", math.pi))     -- 3.14
print("  %e  : " .. string.format("%e", 12345.678))     -- 1.234568e+04
print("  %g  : " .. string.format("%g", 0.000123))      -- 0.000123
print("  %g  : " .. string.format("%g", 1234567.0))     -- 1.23457e+06
print("  %s  : " .. string.format("'%s'", "ola"))
print("  %10s: " .. string.format("%10s", "dir"))       -- alinhado à direita
print("  %%  : " .. string.format("100%%"))             -- 100%
print("")

-- Formatação de tabela
local function fmt_linha(nome, valor, pct)
    return string.format("  %-12s %8d  %6.1f%%", nome, valor, pct)
end
print("  Relatório:")
print(fmt_linha("vendas",   15230, 62.4))
print(fmt_linha("devol.",    1850,  7.6))
print(fmt_linha("estoque",  7420,  30.0))
print("")

-- ── 3. Padding e alinhamento ──────────────────────────────────────────────────
print("── 3. Padding e alinhamento ─────────────────")

local palavras = {"Sea", "linguagem", "VM", "bytecode"}
for i = 0, len(palavras) - 1 do
    local w = palavras[i]
    print("  |" ..
        string.pad_left(w, 10) ..
        "|" ..
        string.pad_center(w, 12) ..
        "|" ..
        string.pad_right(w, 10) ..
        "|")
end
print("")

-- ── 4. Replace, contains, normalize_ws ───────────────────────────────────────
print("── 4. Replace / normalize ───────────────────")

local texto = "  Olá,   mundo!   Bem-vindo   ao   Sea.  "
print("  original : '" .. texto .. "'")
print("  trim     : '" .. string.trim(texto) .. "'")
print("  normalize: '" .. string.normalize_ws(texto) .. "'")

local template = "Olá, {{nome}}! Você tem {{n}} mensagens."
local resultado = string.replace(string.replace(template, "{{nome}}", "Maria"), "{{n}}", "3")
print("  template : " .. resultado)
print("")

-- ── 5. Parser CSV simples ─────────────────────────────────────────────────────
print("── 5. Parser CSV ────────────────────────────")

local csv = "nome,idade,cidade\nAlice,30,São Paulo\nBob,25,Rio\nCarla,35,BH"
local linhas = string.split(csv, "\n")

local cabecalho = string.split(linhas[0], ",")
print("  colunas: " .. string.join(cabecalho, " | "))

for i = 1, len(linhas) - 1 do
    local campos = string.split(linhas[i], ",")
    local linha_str = []
    for j = 0, len(campos) - 1 do
        linha_str[] = string.pad_right(string.trim(campos[j]), 12)
    end
    print("  " .. string.join(linha_str, ""))
end
print("")

-- ── 6. Busca e sub-strings (1-based) ─────────────────────────────────────────
print("── 6. Busca e sub-strings (1-based) ─────────")

local url = "https://api.exemplo.com/v1/usuarios?page=2"
local proto_end = string.find(url, "://")
local proto = string.sub(url, 1, proto_end - 1)
local resto = string.sub(url, proto_end + 3)
print("  protocolo: " .. proto)
print("  restante : " .. resto)
print("  começa com https? " .. tostring(string.starts_with(url, "https")))
print("  termina com =2?   " .. tostring(string.ends_with(url, "=2")))
print("  contém 'v1'?      " .. tostring(string.contains(url, "v1")))
