--
-- Calculadora com Parser Descendente Recursivo em Sea
--
-- Demonstra:
--   - Tokenizer (lexer) escrito à mão com string.byte / string.sub
--   - Parser descendente recursivo com precedência e associatividade:
--       expr   := termo (('+' | '-') termo)*
--       termo  := unario (('*' | '/' | '%') unario)*
--       unario := '-' unario | pot             -- -2^2 = -(2^2)
--       pot    := prim ('^' unario)?           -- potência associa à direita
--       prim   := número | nome | nome '(' args ')' | '(' expr ')'
--   - Árvore sintática como structs; avaliação recursiva; variáveis em map
--   - Erros como valores: error(...) + is_error / propagação com '?'
--

print("╔══════════════════════════════════════════╗")
print("║   Calculadora (lexer + parser + eval)    ║")
print("╚══════════════════════════════════════════╝")
print("")

-- ── Lexer ────────────────────────────────────────────────────────────────────
local function is_digit(b) return b >= 48 and b <= 57 end
local function is_alpha(b) return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 end

local function tokenize(src)
    local toks = []
    local i = 1
    local n = string.len(src)
    while i <= n do
        local b = string.byte(src, i)
        if b == 32 or b == 9 then
            i = i + 1
        elseif is_digit(b) or b == 46 then
            local j = i
            while j <= n and (is_digit(string.byte(src, j)) or string.byte(src, j) == 46) do j = j + 1 end
            toks[] = {kind = "num", text = string.sub(src, i, j - 1)}
            i = j
        elseif is_alpha(b) then
            local j = i
            while j <= n and (is_alpha(string.byte(src, j)) or is_digit(string.byte(src, j))) do j = j + 1 end
            toks[] = {kind = "name", text = string.sub(src, i, j - 1)}
            i = j
        elseif string.contains("+-*/%^(),=", string.char(b)) then
            toks[] = {kind = "op", text = string.char(b)}
            i = i + 1
        else
            return error("caractere inesperado '" .. string.char(b) .. "' na posição " .. i)
        end
    end
    toks[] = {kind = "eof", text = ""}
    return toks
end

-- ── Parser ───────────────────────────────────────────────────────────────────
-- Estado do parser: tokens + posição atual (um único campo mutável `pos`).
local function parser(toks)
    local p = {}
    p.toks = toks
    p.pos = 0
    return p
end

local function peek(p) return p.toks[p.pos] end
local function advance(p)
    local t = p.toks[p.pos]
    p.pos = p.pos + 1
    return t
end
local function accept(p, text)
    local t = peek(p)
    if t.kind == "op" and t.text == text then
        p.pos = p.pos + 1
        return true
    end
    return false
end

local function node(kind, a, b, c)
    local nd = {}
    nd.kind = kind
    nd.a = a
    nd.b = b
    nd.c = c
    return nd
end

local parse_expr = nil

local function parse_primary(p)
    local t = advance(p)
    if t.kind == "num" then
        local v = tonumber(t.text)
        if v == nil then return error("número inválido: " .. t.text) end
        return node("num", v)
    elseif t.kind == "name" then
        if accept(p, "(") then
            local args = []
            if not accept(p, ")") then
                args[] = parse_expr(p)?
                while accept(p, ",") do args[] = parse_expr(p)? end
                if not accept(p, ")") then return error("esperava ')' após argumentos") end
            end
            return node("call", t.text, args)
        end
        return node("var", t.text)
    elseif t.kind == "op" and t.text == "(" then
        local e = parse_expr(p)?
        if not accept(p, ")") then return error("esperava ')'") end
        return e
    end
    if t.kind == "eof" then return error("expressão incompleta") end
    return error("token inesperado '" .. t.text .. "'")
end

local parse_unary = nil

local function parse_power(p)
    local base = parse_primary(p)?
    if accept(p, "^") then return node("bin", "^", base, parse_unary(p)?) end
    return base
end

parse_unary = function(p)
    if accept(p, "-") then return node("neg", parse_unary(p)?) end
    return parse_power(p)
end

local function parse_term(p)
    local left = parse_unary(p)?
    while true do
        local t = peek(p)
        if t.kind == "op" and (t.text == "*" or t.text == "/" or t.text == "%") then
            advance(p)
            left = node("bin", t.text, left, parse_unary(p)?)
        else
            return left
        end
    end
end

parse_expr = function(p)
    local left = parse_term(p)?
    while true do
        local t = peek(p)
        if t.kind == "op" and (t.text == "+" or t.text == "-") then
            advance(p)
            left = node("bin", t.text, left, parse_term(p)?)
        else
            return left
        end
    end
end

-- statement := nome '=' expr | expr
local function parse_line(src)
    local toks = tokenize(src)?
    local p = parser(toks)
    local target = nil
    if toks[0].kind == "name" and toks[1].kind == "op" and toks[1].text == "=" then
        target = toks[0].text
        p.pos = 2
    end
    local e = parse_expr(p)?
    if peek(p).kind ~= "eof" then return error("sobrou '" .. peek(p).text .. "' no fim") end
    return node("stmt", target, e)
end

-- ── Avaliação ────────────────────────────────────────────────────────────────
local vars = [=]
vars["pi"] = math.pi
vars["e"] = math.exp(1)

local funcs = [=]
funcs["sqrt"] = function(a) return math.sqrt(a[0]) end
funcs["abs"] = function(a) return math.abs(a[0]) end
funcs["max"] = function(a)
    local m = a[0]
    for i = 1, len(a) - 1 do if a[i] > m then m = a[i] end end
    return m
end
funcs["hypot"] = function(a) return math.sqrt(a[0] * a[0] + a[1] * a[1]) end

local function eval(nd)
    local k = nd.kind
    if k == "num" then return nd.a end
    if k == "var" then
        local v, ok = vars[nd.a]
        if not ok then return error("variável indefinida '" .. nd.a .. "'") end
        return v
    end
    if k == "neg" then return -(eval(nd.a)?) end
    if k == "call" then
        local f = funcs[nd.a]
        if f == nil then return error("função desconhecida '" .. nd.a .. "'") end
        local args = []
        for _, an in nd.b do args[] = eval(an)? end
        return f(args)
    end
    -- binário
    local x = eval(nd.b)?
    local y = eval(nd.c)?
    local op = nd.a
    if op == "+" then return x + y end
    if op == "-" then return x - y end
    if op == "*" then return x * y end
    if op == "/" then
        if y == 0 then return error("divisão por zero") end
        return x / y
    end
    if op == "%" then return x % y end
    return math.pow(x, y)
end

local function run(src)
    local st = parse_line(src)
    if is_error(st) then return st end
    local v = eval(st.b)?
    if st.a ~= nil then vars[st.a] = v end
    return v
end

local function fmt(v)
    if type(v) == "int" then return tostring(v) end
    if v == math.floor(v) and math.abs(v) < 1e15 then return string.format("%.0f", v) end
    return string.format("%.6g", v)
end

local programa = []
programa[] = "1 + 2 * 3"
programa[] = "(1 + 2) * 3"
programa[] = "2 ^ 3 ^ 2"
programa[] = "-2 ^ 2"
programa[] = "2 ^ -1"
programa[] = "10 % 4 + 7 / 2"
programa[] = "r = 3"
programa[] = "area = pi * r ^ 2"
programa[] = "hypot(3, 4) + max(1, area, 7)"
programa[] = "sqrt(2) * sqrt(2)"
programa[] = "1 / (r - 3)"
programa[] = "2 * (3 + 4"
programa[] = "x + 1"
programa[] = "3 $ 4"

for _, linha in programa do
    local res = run(linha)
    if is_error(res) then
        printf("  %-32s ✗ %s\n", linha, res.message)
    else
        printf("  %-32s = %s\n", linha, fmt(res))
    end
end
