-- particípios -IR ambíguos com -ido (confundiriam com -ER pela regra geral)
irreg["partido"] = "partir"
irreg["dormido"] = "dormir"
irreg["subido"]  = "subir"
irreg["saído"]   = "sair"
irreg["caído"]   = "cair"
