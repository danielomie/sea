irreg["vão"]   = "ir"
irreg["ia"]    = "ir"
irreg["ias"]   = "ir"
irreg["indo"]  = "ir"
-- "foi/foram" → "ser" tem prioridade (adicionados antes); ir usa "foi" também
-- (ambiguidade real da língua — preferimos "ser" como mais frequente)

-- vir
irreg["venho"]  = "vir"
irreg["vens"]   = "vir"
