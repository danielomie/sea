--
-- Verbos → Infinitivo (PT-BR)
--
-- Converte formas conjugadas de verbos portugueses para o infinitivo.
-- Estratégia em dois estágios:
--   1. Dicionário de irregulares (lookup direto, alta confiança)
--   2. Regras de sufixo para verbos regulares (-ar / -er / -ir)
--
-- As regras são tentadas da mais específica (sufixo maior) para a
-- menos específica, retornando na primeira correspondência.
--

-- ─── Utilitários de string ───────────────────────────────────────────────────

local function termina_com(s, sufixo)
    return string.ends_with(s, sufixo)
end

local function remover_sufixo(s, sufixo)
    return string.sub(s, 1, len(s) - len(sufixo))
end

-- ─── Dicionário de irregulares ───────────────────────────────────────────────
-- Formas conjugadas que não seguem padrão regular → infinitivo

local irreg = {}

-- ser
irreg["sou"]    = "ser"
