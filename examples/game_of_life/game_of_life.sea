--
-- Jogo da Vida (Conway) em Sea
--
-- Demonstra:
--   - Grade em int_array (células 0/1, sem refcount por elemento)
--   - Laços aninhados com aritmética inteira e aritmética modular (borda toroidal)
--   - Double buffering: duas grades alternadas a cada geração
--
-- Rode com e sem JIT para comparar:
--   bin/sea examples/game_of_life/game_of_life.sea
--   bin/sea-jit --jit examples/game_of_life/game_of_life.sea
--

print("╔══════════════════════════════════════════╗")
print("║   Jogo da Vida — grade toroidal 64x48    ║")
print("╚══════════════════════════════════════════╝")
print("")

local W = 64
local H = 48

local function new_grid()
    local g = int_array(W * H)
    for i = 0, W * H - 1 do g[] = 0 end
    return g
end

local cur = new_grid()
local nxt = new_grid()

-- Semeia alguns padrões conhecidos.
local function set(g, x, y) g[(y % H) * W + (x % W)] = 1 end

local function glider(g, x, y)
    set(g, x + 1, y); set(g, x + 2, y + 1)
    set(g, x, y + 2); set(g, x + 1, y + 2); set(g, x + 2, y + 2)
end

local function r_pentomino(g, x, y)
    set(g, x + 1, y); set(g, x + 2, y)
    set(g, x, y + 1); set(g, x + 1, y + 1)
    set(g, x + 1, y + 2)
end

local function lwss(g, x, y)   -- nave espacial leve
    set(g, x + 1, y); set(g, x + 4, y)
    set(g, x, y + 1)
    set(g, x, y + 2); set(g, x + 4, y + 2)
    set(g, x, y + 3); set(g, x + 1, y + 3); set(g, x + 2, y + 3); set(g, x + 3, y + 3)
end

glider(cur, 2, 2)
glider(cur, 20, 5)
r_pentomino(cur, 32, 24)
lwss(cur, 5, 35)

local function population(g)
    local n = 0
    for i = 0, W * H - 1 do n = n + g[i] end
    return n
end

-- Uma geração: conta os 8 vizinhos de cada célula (com wrap-around).
local function step(src, dst)
    for y = 0, H - 1 do
        local up = ((y + H - 1) % H) * W
        local row = y * W
        local down = ((y + 1) % H) * W
        for x = 0, W - 1 do
            local l = (x + W - 1) % W
            local r = (x + 1) % W
            local n = src[up + l] + src[up + x] + src[up + r]
                    + src[row + l]                + src[row + r]
                    + src[down + l] + src[down + x] + src[down + r]
            local alive = src[row + x]
            if n == 3 or (alive == 1 and n == 2) then
                dst[row + x] = 1
            else
                dst[row + x] = 0
            end
        end
    end
end

local function render(g)
    local lines = []
    for y = 0, H - 1, 2 do          -- duas linhas por caractere
        local parts = []
        for x = 0, W - 1 do
            local a = g[y * W + x]
            local b = 0
            if y + 1 < H then b = g[(y + 1) * W + x] end
            if a == 1 and b == 1 then parts[] = "█"
            elseif a == 1 then parts[] = "▀"
            elseif b == 1 then parts[] = "▄"
            else parts[] = " " end
        end
        lines[] = "│" .. string.join(parts, "") .. "│"
    end
    return string.join(lines, "\n")
end

local GENS = 2000
if len(os.args) > 1 then GENS = tonumber(os.args[1]) end

printf("geração 0: %d células vivas\n", population(cur))

local t0 = time.now()
for g = 1, GENS do
    step(cur, nxt)
    cur, nxt = nxt, cur              -- troca os buffers
end
local ms = time.since(t0) / 1e6

printf("geração %d: %d células vivas\n", GENS, population(cur))
print("┌" .. string.rep("─", W) .. "┐")
print(render(cur))
print("└" .. string.rep("─", W) .. "┘")
printf("tempo: %.0f ms  (%.1f gerações/s)\n", ms, GENS / (ms / 1000))
