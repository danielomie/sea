-- Inventory of a directory tree: files and bytes by extension, the largest files.
local root = os.args[1]
local count = [=]
local size = [=]
local files = []
for _, p in fs.walk(root, {files = true})? do
    local n = fs.stat(p)?.size
    local ext = path.ext(p)
    if ext == "" then ext = "(none)" end
    list.inc(count, ext)
    list.inc(size, ext, n)
    files[] = {size = n, path = path.relative(root, p)?}
end

print(`files: ${len(files)}, bytes: ${list.sum(list.values(size))}`)
for _, ext in list.keys(count) do printf("  %-8s %5d %10d\n", ext, count[ext], size[ext]) end
print("largest:")
sort.by(files, ["-size", "path"])
for _, f in list.slice(files, 0, 5) do printf("  %6d %s\n", f.size, f.path) end
