-- JIT-friendly: a hot pure-float function called 300K times.
local function fkernel(x, n)
    local s = 0.0
    for i = 0, n do
        s = s + x * 1.5 - 0.5
    end
    return s
end

local total = 0.0
for k = 1, 300000 do
    total = total + fkernel(1.0 * (k % 100), 100)
end
print(total)
