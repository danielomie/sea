-- string concat: build a large string by appending
local s = ""
for i = 1, 50000 do
    s = s .. "hello world "
end
print(len(s))

-- string upper/lower: repeated case conversion
local t = "The quick brown fox jumps over the lazy dog"
local count = 0
for i = 1, 100000 do
    local u = string.upper(t)
    local l = string.lower(u)
    count = count + len(l)
end
print(count)

-- string split and join: parse and reconstruct
local csv = ""
for i = 1, 1000 do
    if i > 1 then csv = csv .. "," end
    csv = csv .. "field" .. i
end
local parts = string.split(csv, ",")
print(len(parts))
