-- Test: the net module and the netpoller (goroutines park on sockets and
-- sleeps instead of holding a scheduler thread)

-- 1. sleeping goroutines run concurrently
local t0 = time.now()
local done = chan(100)
for i = 1, 100 do
    go (function()
        time.sleep(100 * time.Millisecond)
        done <- 1
    end)()
end
local n = 0
for i = 1, 100 do n = n + <-done end
print("sleepers:", n, time.since(t0) // time.Millisecond < 5000)   -- serially: 10 s

-- 2. an echo server; idle connections (more than worker threads) don't block it
local lfd = net.listen(0, "127.0.0.1")
local port = net.local_port(lfd)
go (function()
    while true do
        local fd = net.accept(lfd)
        if is_error(fd) then break end
        go (function()
            while true do
                local data = net.read(fd, 4096, 30000)
                if is_error(data) or data == "" then break end
                net.write(fd, data)
            end
            net.close(fd)
        end)()
    end
end)()

local idle = []
for i = 1, 16 do idle[] = net.connect("127.0.0.1", port) end

local results = chan(50)
for i = 1, 50 do
    go (function()
        local fd = net.connect("127.0.0.1", port, 2000)
        local msg = "msg-" .. i .. string.rep(".", 3000)
        net.write(fd, msg)
        local got = ""
        while len(got) < len(msg) do
            local part = net.read(fd, 65536, 2000)
            if is_error(part) or part == "" then break end
            got = got .. part
        end
        net.close(fd)
        results <- (got == msg) and 1 or 0
    end)()
end
local ok = 0
for i = 1, 50 do ok = ok + <-results end
print("echoes:", ok)

-- 3. timeouts and errors are values
local r = net.read(idle[0], 10, 100)
print("read timeout:", is_error(r), r.message)
print("refused:", is_error(net.connect("127.0.0.1", 1)))
print("peer:", string.starts_with(net.peer(idle[0]), "127.0.0.1:"))

-- 4. closing a socket wakes the goroutine waiting on it
local woke = chan(1)
local wfd = idle[1]
go (function()
    local x = net.read(wfd, 10)
    woke <- is_error(x) or x == ""
end)()
time.sleep(50 * time.Millisecond)
net.close(wfd)
print("close wakes reader:", <-woke)

for i = 2, 15 do net.close(idle[i]) end
net.close(idle[0])
net.close(lfd)
