-- Test: libs/compress (needs make -C libs/compress; zlib1g-dev)
local compress = require("./libs/compress/compress")

print("-- gzip and gunzip")
local data = string.rep("hello world, hello sea! ", 1000)
local gz = compress.gzip(data)
print(len(data), len(gz) < 300, string.byte(gz, 1), string.byte(gz, 2), compress.gunzip(gz) == data)
print(len(compress.gzip(data, 1)) >= len(compress.gzip(data, {level = 9})), len(compress.gzip(data, 0)) > len(data))
print(compress.gunzip(compress.gzip("a") .. compress.gzip("b")), compress.gunzip(compress.gzip("")) == "")
local bin = ""
for i = 0, 255 do bin = bin .. string.char(i) end
print(compress.gunzip(compress.gzip(bin)) == bin)

print("-- deflate and inflate")
local z = compress.deflate(data)
local raw = compress.deflate(data, {format = "raw"})
local g2 = compress.deflate(data, {format = "gzip"})
print(len(raw) < len(z), compress.inflate(z) == data, compress.inflate(g2) == data, compress.inflate(raw, {format = "raw"}) == data)
print(compress.inflate(z, {format = "zlib"}) == data, compress.inflate(g2, {format = "gzip"}) == data)

print("-- errors")
print(compress.gunzip("not gzip"))
print(compress.gunzip(string.sub(gz, 1, 20)))
print(compress.gunzip(gz .. "junk"))
print(compress.gunzip(""))
print(compress.inflate(raw))
print(compress.gunzip(compress.gzip(string.rep("x", 100000)), {max = 1000}))
print(compress.gzip(data, 11))
print(compress.inflate(z, {format = "bogus"}))
print(compress.gzip(42))

print("-- files")
local dir = fs.tempdir("compress-")
local src = dir .. "/data.txt"
fs.write(src, string.rep("line of text\n", 20000))
local n = compress.gzip_file(src, dir .. "/data.txt.gz", {level = 9})
print(n > 0, n == fs.stat(dir .. "/data.txt.gz").size, n < 2000)
print(compress.gunzip_file(dir .. "/data.txt.gz", dir .. "/back.txt"), fs.read(dir .. "/back.txt") == fs.read(src))
print(compress.gunzip(fs.read(dir .. "/data.txt.gz")) == fs.read(src))
fs.write(dir .. "/two.gz", compress.gzip("one ") .. compress.gzip("two"))
print(compress.gunzip_file(dir .. "/two.gz", dir .. "/two.txt"), fs.read(dir .. "/two.txt"))
print(compress.gunzip_file(dir .. "/data.txt.gz", dir .. "/limited", {max = 100}))
print(string.replace(compress.gzip_file(dir .. "/missing", dir .. "/x.gz").message, dir, "<tmp>"))
print(compress.gunzip_file(src, dir .. "/y"))
fs.remove(dir, {recursive = true})
