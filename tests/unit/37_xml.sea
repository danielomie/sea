-- Test: xml library
local xml = require("./libs/xml/xml")

local passed = 0
local failed = 0

local function check(label, got, expected)
    if got == expected then
        passed = passed + 1
    else
        failed = failed + 1
        print("FAIL " .. label .. ": got=" .. tostring(got) .. " expected=" .. tostring(expected))
    end
end

-- ---- Basic element ----------------------------------------------------------

local root = xml.parse("<root/>")
check("self-close tag",  root.tag,  "root")
check("self-close text", root.text, "")

-- ---- Text content -----------------------------------------------------------

local leaf = xml.parse("<name>Alice</name>")
check("leaf tag",  leaf.tag,  "name")
check("leaf text", leaf.text, "Alice")

-- ---- Attributes -------------------------------------------------------------

local elem = xml.parse('<item id="42" active="true"/>')
check("attr id",     xml.attr(elem, "id"),     "42")
check("attr active", xml.attr(elem, "active"), "true")
check("attr miss",   xml.attr(elem, "missing"), nil)

-- ---- Nested elements --------------------------------------------------------

local doc = xml.parse("<root><a>1</a><b>2</b><a>3</a></root>")
check("nested tag", doc.tag, "root")

local first_a = xml.find(doc, "a")
check("find first", xml.text(first_a), "1")

check("find missing", xml.find(doc, "c"), nil)

local all_a = xml.findall(doc, "a")
check("findall len",  len(all_a), 2)
check("findall[0]",   xml.text(all_a[0]), "1")
check("findall[1]",   xml.text(all_a[1]), "3")

-- ---- XML declaration & comments skipped ------------------------------------

local decl = xml.parse('<?xml version="1.0"?><!-- comment --><config><port>8080</port></config>')
check("decl tag",  decl.tag, "config")
local port = xml.find(decl, "port")
check("decl child", xml.text(port), "8080")

-- ---- DOCTYPE skipped --------------------------------------------------------

local dt = xml.parse('<!DOCTYPE html><html><body>hi</body></html>')
check("doctype tag",  dt.tag, "html")
check("doctype child", xml.text(xml.find(dt, "body")), "hi")

-- ---- Entity decoding --------------------------------------------------------

local ent = xml.parse("<p>a &amp; b &lt; c &gt; d &quot;e&quot;</p>")
check("entities", xml.text(ent), 'a & b < c > d "e"')

-- ---- CDATA ------------------------------------------------------------------

local cdata = xml.parse("<code><![CDATA[a < b && c > d]]></code>")
check("cdata", xml.text(cdata), "a < b && c > d")

-- ---- Multiple children ------------------------------------------------------

local cfg = xml.parse("<config><host>localhost</host><port>9000</port></config>")
check("multi host", xml.text(xml.find(cfg, "host")), "localhost")
check("multi port", xml.text(xml.find(cfg, "port")), "9000")

-- ---- Attributes with nested elements ----------------------------------------

local feed = xml.parse('<feed><item id="1" type="news"><title>Hello</title></item><item id="2" type="blog"><title>World</title></item></feed>')
local items = xml.findall(feed, "item")
check("feed len",      len(items), 2)
check("feed attr 0",   xml.attr(items[0], "id"),   "1")
check("feed attr 1",   xml.attr(items[1], "id"),   "2")
check("feed type 0",   xml.attr(items[0], "type"), "news")
local titles = xml.findall(items[0], "title")
check("feed title",    xml.text(titles[0]),        "Hello")

-- ---- Encode -----------------------------------------------------------------

local node = xml.parse("<greeting lang=\"en\">Hello</greeting>")
local enc  = xml.encode(node)
check("encode basic", enc, '<greeting lang="en">Hello</greeting>')

local sc = xml.parse("<br/>")
check("encode self-close", xml.encode(sc), "<br/>")

-- ---- Encode round-trip ------------------------------------------------------

local orig = xml.parse('<root><child id="x">text</child></root>')
local rt   = xml.parse(xml.encode(orig))
check("roundtrip tag",    rt.tag, "root")
local rtch = xml.find(rt, "child")
check("roundtrip child",  xml.text(rtch),        "text")
check("roundtrip attr",   xml.attr(rtch, "id"),  "x")

-- ---- Error cases ------------------------------------------------------------

check("parse empty",   is_error(xml.parse("")),        true)
check("parse garbage", is_error(xml.parse("not xml")), true)
check("parse unclosed",is_error(xml.parse("<a>")),     true)
check("encode non-node", is_error(xml.encode("string")), true)

-- ---- Summary ----------------------------------------------------------------

print("xml tests: " .. passed .. "/" .. (passed + failed) .. " passed")
if failed == 0 then
    print("ALL PASS")
end
