-- Test: copy propagation (Etapa 3)
-- local y = x skips the MOVE and reads x's register directly

local x = 42
local y = x
print(y)   -- 42

-- Copy chain: z copies y which copies x
local z = y
print(z)   -- 42

-- Source mutated after copy: copy retains original value
local a = 10
local b = a   -- b.has_copy = a
a = 99        -- materializes b = 10 before overwriting a
print(b)      -- 10
print(a)      -- 99

-- Copy inside a function
local function add_one(n)
    local v = n
    return v + 1
end
print(add_one(7))  -- 8

-- Mutable copy in straight-line code
local p = 5
local q = p
q = q + 3
print(p)   -- 5
print(q)   -- 8
