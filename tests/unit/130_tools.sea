-- Test: the built-in tools `sea fmt` and `sea doc` (run as ./bin/sea from the repo root)
local SEA = "./bin/sea"

local dir = fs.tempdir("seatools-")
local function run(args, stdin)
    local cmd = []
    cmd[] = SEA
    for i = 0, len(args) - 1 do cmd[] = args[i] end
    local opts = {}
    opts.cwd = dir
    if stdin ~= nil then opts.stdin = stdin end
    local r = process.run(cmd, opts)
    if is_error(r) then return r.message end
    return "[" .. tostring(r.code) .. "] " .. string.trim(r.stdout) .. (r.stderr ~= "" and (" | " .. string.trim(r.stderr)) or "")
end
-- the binary path relative to dir: absolute
SEA = fs.realpath(SEA)

print("-- sea fmt")
fs.write(dir .. "/a.sea", "local   x=1\nif x then print( x ) end\n")
fs.write(dir .. "/ok.sea", "local y = 2\n")
fs.mkdir(dir .. "/sub")
fs.write(dir .. "/sub/bad.sea", "local = 1\n")
print(run({"fmt", "-l", "."}))
print(run({"fmt", "--check", "a.sea", "ok.sea"}))
print(run({"fmt", "-p", "a.sea"}))
print(run({"fmt"}, "local t={a=1}\n"))
print(run({"fmt", "a.sea"}), fs.read(dir .. "/a.sea") == "local x = 1\nif x then print(x) end\n")
print(run({"fmt", "--check", "a.sea", "ok.sea"}))
print(run({"fmt", "--bogus"}))

print("-- sea doc")
fs.remove(dir .. "/sub/bad.sea")
fs.write(dir .. "/mylib.sea", [==[
-- mylib — a small library
--
-- Usage:
--   local m = require("mylib")

local M = {}
local Box = {}

-- m.add(a, b) → the sum
function M.add(a, b)
    return a + b
end

--[[ m.join(...) → the values joined with ", " ]]
function M.join(...)
    return ""
end

-- the size of a box
function Box.size(self)
    return 1
end

local function helper(x)
    return x
end

-- a constant
M.VERSION = "1.0"

return M
]==]
)
print(run({"doc", "mylib.sea"}))
print(run({"doc", "mylib.sea", "add"}))
print(run({"doc", "--all", "mylib.sea", "helper"}))
print(run({"doc", "-f", "markdown", "mylib.sea", "join"}))
print(run({"doc", "-f", "json", "mylib.sea", "size"}))
print(run({"doc", "mylib.sea", "nothing"}))
local html = run({"doc", "-f", "html", "-o", "out.html", "mylib.sea"})
print(html, string.contains(fs.read(dir .. "/out.html"), "<code>mylib.add(a, b)</code>"))
print(string.sub(run({"doc", "re"}), 1, 40))

print("-- sea test")
local function untimed(s)
    s = re.gsub("[0-9.]+ ns/op", s, "N ns/op")
    s = re.gsub("  +[0-9]+  +N", s, " N N")
    return re.gsub("\\([0-9.]+ s\\)", s, "(T)")
end
fs.mkdir(dir .. "/t")
fs.mkdir(dir .. "/t/.git")
fs.write(dir .. "/t/.git/x_test.sea", "print('hidden')\n")
fs.write(dir .. "/t/lib.sea", "local M = {}\nfunction M.double(x) return x * 2 end\nreturn M\n")
fs.write(dir .. "/t/lib_test.sea", [==[
local t = require("sea/test")
local lib = require("./lib")
t.describe("double", function()
    t.it("ints", function() t.eq(lib.double(2), 4) end)
    t.it("floats", function() t.eq(lib.double(0.5), 1.0) end)
end)
t.bench("double", function(b) for i = 1, b.n do lib.double(i) end end)
]==]
)
fs.write(dir .. "/t/z_test.sea", [==[
local t = require("sea/test")
t.it("broken", function() print("noise"); t.eq(1, 2) end)
t.main()
]==]
)
print(untimed(run({"test", "t"})))
print(untimed(run({"test", "-run", "ints", "t/lib_test.sea"})))
print(untimed(run({"test", "-v", "-bench", ".", "-benchtime", "0.01", "t/lib_test.sea"})))
fs.write(dir .. "/t/z_test.sea", "local x = = 1\n")
print(untimed(run({"test", "t"})))
fs.mkdir(dir .. "/empty")
print(run({"test", "empty"}))

print("-- sea check")
fs.write(dir .. "/c.sea", [==[
local json = require("./nope")
local x = 1
local x = 2
pritn(x)
local function add(a, b) return a + b end
print(add(1, 2, 3))
print(string.format("%d %s", 1))
local t = {a = 1, a = 2}
t = t
local function f()
    panic("x")
    print("dead")
end
local arr = array()
do
    local x = 5
    print(x)
end
local z = 1 -- check:ignore
local w = 2 -- check:ignore shadow
for k, v in t do print(v) end
print(f, arr, helper)
]==]
)
fs.write(dir .. "/d.sea", "function helper() return 1 end\n")
print(run({"check", "c.sea", "d.sea"}))
print(run({"check", "-only", "undefined,args", "c.sea"}))
print(run({"check", "-disable", "shadow,redeclared,require", "-all", "-g", "helper", "c.sea"}))
print(run({"check", "-f", "json", "-only", "format", "c.sea"}))
print(run({"check", "d.sea"}))
print(run({"check", "-only", "bogus", "d.sea"}))
fs.write(dir .. "/w.sea", "local unused = 1\n")
print(run({"check", "-w", "w.sea"}))

print("-- sea build")
fs.mkdir(dir .. "/app")
fs.mkdir(dir .. "/app/lib")
fs.write(dir .. "/app/main.sea", [==[
local util = require("./lib/util")
local name = "plug" .. "in"
local plugin = require("./lib/" .. name)
print(util.greet(os.args[1] or "world"), len(os.args) - 1, plugin.ok)
if os.args[1] == "boom" then panic("kaboom") end
]==]
)
fs.write(dir .. "/app/lib/util.sea", "local M = {}\nfunction M.greet(n) return \"hello, \" .. n end\nreturn M\n")
fs.write(dir .. "/app/lib/plugin.sea", "return {ok = true}\n")
print(re.gsub("[0-9.]+ MB", run({"build", "-v", "-o", "hello", "-i", "app/lib/plugin.sea", "app/main.sea"}), "N MB"))
fs.rename(dir .. "/app", dir .. "/moved")
local function run_exe(args)
    local cmd = []
    cmd[] = dir .. "/hello"
    for i = 0, len(args) - 1 do cmd[] = args[i] end
    local r = process.run(cmd, {cwd = "/"})
    return "[" .. tostring(r.code) .. "] " .. string.trim(r.stdout) .. (r.stderr ~= "" and (" | " .. string.trim(r.stderr)) or "")
end
print(run_exe({}))
print(run_exe({"there", "--jit", "x"}))
print(run_exe({"boom"}))
fs.write(dir .. "/bad.sea", "local m = require(\"./missing\")\n")
print(run({"build", "bad.sea"}))
print(run({"build"}))

print("-- sea test -cover")
fs.mkdir(dir .. "/cv")
fs.write(dir .. "/cv/mathx.sea", [==[
local M = {}
function M.double(x) return x * 2 end
function M.sign(x)
    if x > 0 then
        return 1
    elseif x < 0 then
        return -1
    end
    return 0
end
return M
]==]
)
fs.write(dir .. "/cv/mathx_test.sea", [==[
local t = require("sea/test")
local m = require("./mathx")
t.it("doubles", function() t.eq(m.double(2), 4) end)
t.it("sign", function() t.eq(m.sign(5), 1) end)
]==]
)
print(untimed(run({"test", "-cover", "-coverprofile", "c.lcov", "cv"})))
local lcov = fs.read(dir .. "/c.lcov")
print(string.contains(lcov, "/cv/mathx.sea\nDA:1,1\n"), string.contains(lcov, "DA:7,0"), string.contains(lcov, "LH:6"))

print("-- sea prof")
fs.write(dir .. "/hot.sea", [==[
local function spin(n)
    local t = 0
    for i = 1, n do t = (t + i) % 7 end
    return t
end
local wg = sync.waitgroup()
for _ = 1, 2 do
    wg:add(1)
    go (function()
        print(spin(3000000))
        wg:done()
    end)()
end
wg:wait()
]==]
)
local p = process.run({SEA, "prof", "-hz", "1000", "hot.sea"}, {cwd = dir})
print(p.code, string.trim(p.stdout), string.contains(p.stderr, "samples"), re.test("%\\s+[0-9.]+\\s+spin\\s+hot.sea:1", p.stderr),
    re.test("hot.sea:[23]\\s+\\(spin\\)", p.stderr))
p = process.run({SEA, "prof", "-o", "out.folded", "hot.sea"}, {cwd = dir})
print(p.code, string.contains(fs.read(dir .. "/out.folded"), "(anonymous) (hot.sea:9);spin (hot.sea:1) "))
p = process.run({SEA, "prof"}, {cwd = dir})
print(p.code, string.sub(p.stderr, 1, 15))

print("-- sea new")
print(run({"new", "--no-git", "proj"}))
print(run({"new", "--lib", "--no-git", "mylib"}))
print(run({"new", "9x"}))
local function run_in(sub, args)
    local cmd = []
    cmd[] = SEA
    for i = 0, len(args) - 1 do cmd[] = args[i] end
    local r = process.run(cmd, {cwd = dir .. "/" .. sub})
    if is_error(r) then return r.message end
    return "[" .. tostring(r.code) .. "] " .. string.trim(r.stdout) .. (r.stderr ~= "" and (" | " .. string.trim(r.stderr)) or "")
end
print(untimed(run_in("proj", {"test"})))
print(run_in("proj", {"check"}), run_in("proj", {"fmt", "-l", "."}), run_in("proj", {"main.sea", "you"}))
print(untimed(run_in("mylib", {"test"})))

print("-- sea get")
local function sh(cwd, cmd)
    local r = process.run({"sh", "-c", cmd}, {cwd = cwd})
    if not r.ok then print("sh failed:", cmd, r.stderr) end
end
local repos = dir .. "/repos"
fs.mkdir(repos .. "/pad", {parents = true})
fs.mkdir(repos .. "/strutil", {parents = true})
local commit = "git -c user.email=t@t -c user.name=t commit -qm"
fs.write(repos .. "/pad/init.sea", "local M = {}\nfunction M.left(s, n) return string.rep(\" \", n - len(s)) .. s end\nreturn M\n")
sh(repos .. "/pad", "git init -q && git add -A && " .. commit .. " v1 && git tag v1.0.0")
fs.write(repos .. "/strutil/strutil.sea", "local pad = require(\"pad\")\nlocal M = {}\nM.VERSION = \"1\"\nfunction M.shout(s) return pad.left(string.upper(s), 6) end\nreturn M\n")
fs.write(repos .. "/strutil/sea.toml", "[package]\nname = \"strutil\"\n\n[dependencies]\npad = { git = \"" .. repos .. "/pad\", tag = \"v1.0.0\" }\n")
sh(repos .. "/strutil", "git init -q && git add -A && " .. commit .. " v1 && git tag v1.0.0 && sed -i 's/VERSION = \"1\"/VERSION = \"2\"/' strutil.sea && " .. commit ..
    " v2 -a && git tag v2.0.0")
fs.write(dir .. "/proj/main.sea", "local strutil = require(\"strutil\")\nprint(\"[\" .. strutil.shout(\"hi\") .. \"]\", strutil.VERSION)\n")
local function hide(s) return string.replace(re.gsub("[0-9a-f]{12}", s, "C"), repos, "REPOS") end
print(hide(run_in("proj", {"get", repos .. "/strutil@v1.0.0"})))
print(run_in("proj", {"main.sea"}), run_in("proj", {"check", "main.sea"}))
print(hide(string.replace(fs.read(dir .. "/proj/sea.toml"), "\n", " | ")))
print(len(string.split(string.trim(fs.read(dir .. "/proj/sea.lock")), "\n")))
fs.remove(dir .. "/proj/sea_modules", {recursive = true})
print(hide(run_in("proj", {"get"})))
fs.write(dir .. "/proj/sea.toml", string.replace(fs.read(dir .. "/proj/sea.toml"), "v1.0.0", "v2.0.0"))
print(hide(run_in("proj", {"get"})), run_in("proj", {"main.sea"}))
print(hide(run_in("proj", {"get", "-l"})))
print(re.gsub("[0-9.]+ MB", run_in("proj", {"build", "-o", "app", "main.sea"}), "N MB"))
fs.mkdir(dir .. "/locallib")
fs.write(dir .. "/locallib/init.sea", "return {x = 42}\n")
print(hide(string.replace(run_in("proj", {"get", "-path", "../locallib"}), dir, "DIR")))
print(run_in("proj", {"get", "-rm", "strutil"}), string.join(fs.list(dir .. "/proj/sea_modules"), ","))
print(run_in("proj", {"get", "-rm", "nothing"}))
print(run({"get"}))
local app = process.run({dir .. "/proj/app"}, {cwd = "/"})
print(app.code, string.trim(app.stdout))
fs.remove(dir, {recursive = true})
