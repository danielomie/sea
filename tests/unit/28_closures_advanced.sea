-- Test: advanced closures

-- 1. Counter factory: each closure is independent
local function make_counter(start)
    local n = start
    return function()
        n = n + 1
        return n
    end
end

local c1 = make_counter(0)
local c2 = make_counter(10)

assert(c1() == 1,  "c1 call 1")
assert(c1() == 2,  "c1 call 2")
assert(c2() == 11, "c2 call 1 (independent state)")
assert(c1() == 3,  "c1 call 3")
assert(c2() == 12, "c2 call 2")

-- 2. Shared upvalue between two closures (getter/setter pattern)
local function make_cell(init)
    local val = init
    local function set(x) val = x end
    local function get() return val end
    return set, get
end

local set_a, get_a = make_cell(100)
local set_b, get_b = make_cell(200)

assert(get_a() == 100, "initial value a")
assert(get_b() == 200, "initial value b")
set_a(42)
assert(get_a() == 42, "after set_a(42)")
assert(get_b() == 200, "b unaffected by set_a")
set_b(99)
assert(get_b() == 99, "after set_b(99)")
assert(get_a() == 42, "a unaffected by set_b")

-- 3. Closure captures loop variable (each iteration has own var via 'local')
local funcs = []
for i = 1, 5 do
    local captured = i   -- each iteration creates a new local
    funcs[] = function() return captured end
end
assert(funcs[0]() == 1, "closure captures loop 1")
assert(funcs[1]() == 2, "closure captures loop 2")
assert(funcs[2]() == 3, "closure captures loop 3")
assert(funcs[3]() == 4, "closure captures loop 4")
assert(funcs[4]() == 5, "closure captures loop 5")

-- 4. Deeply nested closures sharing upvalues
local function level1(x)
    return function(y)
        return function(z)
            return x + y + z
        end
    end
end

local add_1_2 = level1(1)(2)
assert(add_1_2(3)  == 6,  "1+2+3 = 6")
assert(add_1_2(10) == 13, "1+2+10 = 13")

local add_5_7 = level1(5)(7)
assert(add_5_7(1)  == 13, "5+7+1 = 13")

-- 5. Closure that mutates upvalue, read from another closure
local function make_accumulator()
    local total = 0
    return {
        add = function(x) total = total + x end,
        sub = function(x) total = total - x end,
        get = function() return total end,
    }
end

local acc = make_accumulator()
acc.add(10)
acc.add(5)
acc.sub(3)
assert(acc.get() == 12, "accumulator: 10+5-3 = 12")

-- 6. Closure survives past the function that created it
local stored = nil
local function setup()
    local secret = 777
    stored = function() return secret end
end
setup()
assert(stored() == 777, "closure outlives creating function")

print("PASS: closures advanced")
