-- Test: higher-order functions
-- map
local function map_fn(t, fn)
    local result = {}
    for i, v in t do
        result[i] = fn(v)
    end
    return result
end

local nums = {1, 2, 3, 4, 5}
local doubled = map_fn(nums, function(x) return x * 2 end)
for i, v in doubled do
    print(v)
end
-- 2 4 6 8 10

-- filter
local function filter_fn(t, pred)
    local result = {}
    local idx = 0
    for i, v in t do
        if pred(v) then
            result[idx] = v
            idx = idx + 1
        end
    end
    return result
end

local odds = filter_fn(nums, function(x) return x % 2 ~= 0 end)
for i, v in odds do
    print(v)
end
-- 1 3 5

-- reduce / fold
local function reduce(t, fn, init)
    local acc = init
    for i, v in t do
        acc = fn(acc, v)
    end
    return acc
end

local sum = reduce(nums, function(a, b) return a + b end, 0)
print(sum)   -- 15

local product = reduce(nums, function(a, b) return a * b end, 1)
print(product)  -- 120

-- compose
local function compose(f, g)
    return function(x) return f(g(x)) end
end

local add1 = function(x) return x + 1 end
local times2 = function(x) return x * 2 end
local add1_then_times2 = compose(times2, add1)
print(add1_then_times2(4))   -- 10

-- memoize
local function memoize(fn)
    local cache = {}
    return function(n)
        if cache[n] ~= nil then
            return cache[n]
        end
        local v = fn(n)
        cache[n] = v
        return v
    end
end

local slow_double = memoize(function(x) return x * 2 end)
print(slow_double(5))   -- 10
print(slow_double(5))   -- 10 (cached)
print(slow_double(7))   -- 14
