for r = 0, 3 do
    wg.add(wg, 1)
    go (function()
        local bad = 0
        for i = 0, 20000 do
            if math == nil or string == nil or tostring == nil then bad = bad + 1 end
        end
        mu.acquire(mu)
        lost = lost + bad
        mu.release(mu)
        wg.done(wg)
    end)()
end
wg.wait(wg)
print("builtins missing:", lost)
local sum = g0_191 + g1_191 + g2_191 + g3_191 + g0_0 + g3_100
