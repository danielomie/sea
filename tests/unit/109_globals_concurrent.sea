-- shared counter under a mutex
counter = 0
for k = 0, 7 do
    wg.add(wg, 1)
    go (function()
        for i = 1, 1000 do
            mu.acquire(mu)
            counter = counter + 1
            mu.release(mu)
        end
        wg.done(wg)
    end)()
end
wg.wait(wg)
print("counter:", counter)
