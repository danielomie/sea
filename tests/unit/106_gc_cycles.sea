-- Test: the cycle collector (gc.collect / gc.stats, docs/memory.md)

gc.collect()   -- start from an empty buffer

-- 1. a two-object cycle, unreachable once the function returns
local function make_pair()
    local a = {}
    local b = {}
    a.peer = b
    b.peer = a
end
make_pair()
print(gc.collect())                         -- 2

-- 2. self-references: table, map, array, closure over its own table
local function selfs()
    local t = {}
    t.me = t
    local m = [=]
    m["me"] = m
    local arr = []
    arr[] = arr
    local obj = {}
    obj.f = function() return obj end      -- obj -> closure -> upvalue -> obj
end
selfs()
print(gc.collect())                         -- 6

-- 3. a ring of 10 nodes plus a string each: all freed, strings included
local function ring()
    local first = {}
    first.name = "node" .. string.rep("-", 70)
    local prev = first
    for i = 1, 9 do
        local n = {}
        n.name = "node" .. i .. string.rep("-", 70)
        prev.next = n
        prev = n
    end
    prev.next = first
end
ring()
print(gc.collect())                         -- 10

-- 4. live data is never freed: a cycle still referenced from a local
local keep = {}
keep.self = keep
keep.value = 42
local alias = keep
alias = nil                                -- a release that leaves keep alive
print(gc.collect(), keep.self.value)        -- 0  42

-- 5. a garbage cycle pointing at live data: only the cycle goes
local shared = {}
shared.n = 7
local function dangling()
    local x = {}
    local y = {}
    x.peer = y
    y.peer = x
    y.data = shared
end
dangling()
print(gc.collect(), shared.n)               -- 2  7

-- 6. stats
local s = gc.stats()
print(s.collections >= 5, s.freed >= 20, s.candidates)   -- true  true  0
