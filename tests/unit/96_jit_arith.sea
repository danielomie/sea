-- Arithmetic edge cases for the JIT's inline MOD / IDIV / POW / NEG / bitwise
-- paths. Each operation runs inside a loop so `make test-jit` compiles it; the
-- output must match the interpreter exactly.

local function show(label, f)
    local r = nil
    for k = 1, 3 do r = f() end
    print(label, r)
end

-- modulo: floored, sign follows the divisor (int and float)
local ia = {7, -7, 7, -7, 0, 5}
local ib = {3, 3, -3, -3, 4, 5}
for i = 0, len(ia) - 1 do
    local x = ia[i]
    local y = ib[i]
    local m = 0
    local q = 0
    for k = 1, 3 do
        m = x % y
        q = x // y
    end
    print("int", x, y, m, q)
end

local fa = {7.5, -7.5, 7.5, -7.5, 1.0, 7}
local fb = {2.0, 2.0, -2.0, -2.0, 0.25, 2.5}
for i = 0, len(fa) - 1 do
    local x = fa[i]
    local y = fb[i]
    local m = 0
    local q = 0
    for k = 1, 3 do
        m = x % y
        q = x // y
    end
    print("flt", x, y, m, q)
end

-- negation of ints and floats
local negs = {5, -3, 2.5, -0.5}
for i = 0, len(negs) - 1 do
    local v = negs[i]
    local r = 0
    for k = 1, 3 do r = -v end
    print("neg", v, r)
end

-- pow always yields a number
local bases = {2, 2.5, 9, -2}
local exps  = {10, 2, 0.5, 3}
for i = 0, len(bases) - 1 do
    local x = bases[i]
    local y = exps[i]
    local r = 0
    for k = 1, 3 do r = x ^ y end
    print("pow", x, y, r)
end

-- bitwise (floats are truncated to int), shifts incl. negative and >= 64
local xs = {12, -1, 255, 6.9}
local ys = {10, 4, 3, 3}
for i = 0, len(xs) - 1 do
    local x = xs[i]
    local y = ys[i]
    local a1 = 0
    local a2 = 0
    local a3 = 0
    local a4 = 0
    for k = 1, 3 do
        a1 = x & y
        a2 = x | y
        a3 = x ~ y
        a4 = ~x
    end
    print("bit", x, y, a1, a2, a3, a4)
end

local shifts = {0, 1, 5, -2, 63, 64, -64, 100}
for i = 0, len(shifts) - 1 do
    local s = shifts[i]
    local l = 0
    local r = 0
    for k = 1, 3 do
        l = 1000 << s
        r = 1000 >> s
    end
    print("shift", s, l, r)
end

-- accumulate in a hot loop mixing the ops
local acc = 0
for i = 1, 20000 do
    acc = (acc + (i % 7) * (i // 3) + (i & 15) - (i >> 2)) % 1000003
end
print("acc", acc)
