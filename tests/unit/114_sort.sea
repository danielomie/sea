-- Test: the sort module
-- Natural order, comparators, stability, sort.by, typed arrays, sorted,
-- reverse, is_sorted, search, errors, and a panic inside a comparator.

local function arr(s)
    local a = []
    for _, v in string.split(s, " ") do
        local n = tonumber(v)
        if n ~= nil then a[] = n else a[] = v end
    end
    return a
end

-- natural order: ints and floats together, strings by bytes
local a = arr("5 3.5 9 1 -7 3")
sort.sort(a)
print("numbers", string.join(a, " "))
local s = arr("banana maçã abacaxi Uva banana")
sort.sort(s)
print("strings", string.join(s, " "))
local nan = []
nan[] = 2
nan[] = 0 / 0
nan[] = -1
sort.sort(nan)
print("nan last", nan[0], nan[1], isnan(nan[2]))

-- ready-made and custom comparators
sort.sort(a, sort.desc)
print("desc", string.join(a, " "))
sort.sort(a, sort.asc)
print("asc", string.join(a, " "))
local m = arr("9 7 5 3 3 1 6 4")
sort.sort(m, function(x, y) return x % 3 < y % 3 end)
print("stable custom", string.join(m, " "))
print("returns the array", sort.sort(arr("2 1"))[0])

-- sort.by: a field (tables and structs) or a function; stable; reverse
local people = []
people[] = {name = "ana", age = 30}
people[] = {name = "bia", age = 25}
people[] = {name = "caio", age = 30}
people[] = {name = "duda", age = 20}
local t = {}
t.name = "eva"
t.age = 25
people[] = t
sort.by(people, "age")
local names = []
for _, p in people do names[] = p.name .. ":" .. p.age end
print("by field", string.join(names, " "))
sort.by(people, function(p) return len(p.name) end, true)
names = []
for _, p in people do names[] = p.name end
print("by function, reverse", string.join(names, " "))

-- sorted copies leave the original alone
local orig = arr("3 1 2")
local copy = sort.sorted(orig)
print("sorted", string.join(copy, " "), "original", string.join(orig, " "))

-- typed arrays
local ia = int_array()
for _, v in string.split("4 -2 8 0 8", " ") do ia[] = tonumber(v) end
sort.sort(ia)
print("int_array", ia[0], ia[1], ia[2], ia[3], ia[4])
sort.sort(ia, function(x, y) return x > y end)
print("int_array desc", ia[0], ia[4])
local fa = float_array()
for _, v in string.split("0.5 -1.5 2.25", " ") do fa[] = tonumber(v) end
local fs = sort.sorted(fa, sort.desc)
print("float_array", fs[0], fs[1], fs[2], "original first", fa[0])

-- reverse, is_sorted, search (first index not less than x)
print("reverse", string.join(sort.reverse(arr("1 2 3 4")), " "))
print("is_sorted", sort.is_sorted(arr("1 2 2 3")), sort.is_sorted(arr("2 1")),
      sort.is_sorted(arr("3 2 1"), sort.desc), sort.is_sorted([]))
local sorted = arr("1 3 3 5 8")
print("search", sort.search(sorted, 3), sort.search(sorted, 4), sort.search(sorted, 0),
      sort.search(sorted, 9), sort.search(ia, 5, function(x, y) return x > y end))

-- errors are runtime errors, raised before the array changes
local function try(f)
    local msg = nil
    local function run()
        defer function()
            local e = recover()
            if e ~= nil then msg = tostring(e) end
        end
        f()
    end
    run()
    return msg
end
local mixed = []
mixed[] = 1
mixed[] = "a"
print("mixed", string.contains(try(function() sort.sort(mixed) end), "cannot compare"), mixed[0], mixed[1])
print("not an array", string.contains(try(function() sort.sort({}) end), "expected an array"))
print("bad comparator", string.contains(try(function() sort.sort(arr("1 2"), 3) end), "comparator"))
local victim = arr("3 1 2")
print("changed by comparator", string.contains(try(function()
    sort.sort(victim, function(x, y)
        victim[0] = 100
        return x < y
    end)
end), "changed"))
print("bad keys", string.contains(try(function() sort.by(people, "nope") end), "keys"))

-- a panic in the comparator leaves the array as it was
local keep = arr("3 1 2 5 4")
local msg = try(function()
    sort.sort(keep, function(x, y)
        if x == 5 then panic("five!") end
        return x < y
    end)
end)
print("panic", msg, string.join(keep, " "))

-- a bigger array, sorted and stable
local big = []
local seed = 12345
for i = 1, 5000 do
    seed = (seed * 1103515245 + 12345) % 2147483648
    big[] = {k = seed % 100, i = i}
end
sort.by(big, "k")
local ok = true
for i = 1, len(big) - 1 do
    local p, q = big[i - 1], big[i]
    if p.k > q.k or (p.k == q.k and p.i > q.i) then ok = false end
end
print("5000 by key, stable", ok)
local nums = []
for i = 1, 5000 do nums[] = big[i - 1].k * 1000 + big[i - 1].i end
sort.sort(nums, function(x, y) return x > y end)
print("5000 with a comparator", sort.is_sorted(nums, sort.desc))
