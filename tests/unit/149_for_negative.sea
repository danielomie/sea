-- Test: numeric for loops whose index crosses zero (the loop compared the
-- raw NaN-boxed words, where a negative int sorts above a positive one)
local function count(a, b, step)
    local n = 0
    local last = nil
    for i = a, b, step or 1 do
        n += 1
        last = i
    end
    return `${n}/${last}`
end
print(count(-1, 1), count(-2, 1), count(-1, 0), count(-1, 5), count(-3, -1))
print(count(-5, 5, 2), count(-1, 1, 1), count(1, -1, -1), count(-140737488355320, -140737488355318))
local s = 0
for dy = -1, 1 do
    for dx = -1, 1 do s += dx * 10 + dy end
end
print(s)
local cells = []
for i = -2, 2 do cells[] = i end
print(string.join(cells, ","))
