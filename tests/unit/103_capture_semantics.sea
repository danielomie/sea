-- Variable capture semantics.
-- 1) Loop variables are fresh per iteration (as in Lua 5.4 and Go 1.22):
--    closures and goroutines created in a loop body see that iteration's value.
-- 2) A local captured by a goroutine's closure and later assigned a new object
--    by its owner must hand the goroutine a properly shared object.

-- 1a. numeric for
local fns = []
for i = 1, 3 do fns[] = function() return i end end
print("for", fns[0](), fns[1](), fns[2]())

-- 1b. for-in (both variables)
local gs = []
for k, v in {10, 20, 30} do gs[] = function() return k .. "=" .. v end end
print("for-in", gs[0](), gs[1](), gs[2]())

-- 1c. `continue` still gives each iteration its own variables
local cs = []
for i = 1, 6 do
    local sq = i * i
    if i % 2 == 0 then continue end
    cs[] = function() return i .. ":" .. sq end
end
print("continue", cs[0](), cs[1](), cs[2]())

-- 1d. the variable can still be modified inside its own iteration
local ms = []
for i = 1, 3 do
    local f = function() return i end
    i = i * 100
    ms[] = f
end
print("modified", ms[0](), ms[1](), ms[2]())

-- 1e. goroutines started in a loop each see their own i
local ch = chan(10)
for i = 1, 10 do go (function() ch <- i end)() end
local s = 0
for i = 1, 10 do s = s + <-ch end
print("goroutines", s)

-- 2. owner reassigns a captured local after the goroutine started; both
--    threads then retain/release the new object concurrently
local cfg = {v = 1}
local ready = chan()
local done = chan()
go (function()
    local _ = <-ready
    local keep = []
    local total = 0
    for i = 1, 2000 do
        keep[] = cfg
        total = total + cfg.v
    end
    done <- total
end)()
cfg = {v = 2}
ready <- true
local mine = []
for i = 1, 2000 do mine[] = cfg end
print("reassigned", <-done, len(mine))

-- 3. a goroutine can run a native function directly (used to crash the VM)
go print("native goroutine ok")
