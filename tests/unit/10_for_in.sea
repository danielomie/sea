-- Test: for-in loops
-- over table literal (integer keys, 0-based)
local t = {10, 20, 30}
for i, v in t do
    print(i, v)
end
-- 0	10
-- 1	20
-- 2	30

-- over table with string keys
local m = {a=1, b=2, c=3}
local keys = []
local vals = []
for k, v in m do
    keys[] = k
    vals[] = v
end
-- sum of values
local sum = 0
for i, v in vals do
    sum = sum + v
end
print(sum)  -- 6

-- for-in with array
local arr = []
arr[] = "p"
arr[] = "q"
arr[] = "r"
for i, v in arr do
    print(v)
end
-- p
-- q
-- r

-- single variable for-in (index only or value only)
for i in {100, 200, 300} do
    print(i)
end
-- 0
-- 1
-- 2
