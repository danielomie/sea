-- Test: the fs and path modules

local d = fs.tempdir("seatest-")
local function show(v)
    if is_error(v) then return "error: " .. string.replace(v.message, d, "<tmp>") end
    if type(v) == "string" then return string.replace(v, d, "<tmp>") end
    return tostring(v)
end
local function p(name) return path.join(d, name) end

print("-- read, write, append")
print(path.isabs(d), fs.isdir(d), fs.isfile(d), fs.exists(d))
print(fs.write(p("a.txt"), "hello\n"), fs.append(p("a.txt"), "world\n"))
print(show(fs.read(p("a.txt"))))
print(fs.write(p("a.txt"), "more\n", {append = true}), len(fs.read(p("a.txt"))))
print(fs.write(p("atomic.txt"), "all or nothing", {atomic = true}), fs.read(p("atomic.txt")))
print(fs.write(p("empty"), ""), "[" .. fs.read(p("empty")) .. "]")
local bin = string.char(0, 255, 10, 13)
print(fs.write(p("bin"), bin), fs.read(p("bin")) == bin)
print(show(fs.read(p("missing"))))
print(show(fs.write(p("no/such/dir.txt"), "x")))
print(show(fs.read(d)))

print("-- stat")
local st = fs.stat(p("a.txt"))
print(st.type, st.size, st.mode > 0, st.mtime > 0, st.nlink, type(st.uid))
print(fs.stat(d).type, show(fs.stat(p("missing"))))
print(fs.chmod(p("a.txt"), 0x180), fs.stat(p("a.txt")).mode == 0x180)     -- 0600
print(fs.write(p("mode.txt"), "x", {mode = 0x1C0}), fs.stat(p("mode.txt")).mode & 0x1C0 == 0x1C0)
print(fs.touch(p("touched")), fs.stat(p("touched")).size, fs.touch(p("a.txt")), fs.stat(p("a.txt")).size)

print("-- directories")
print(fs.mkdir(p("x/y/z"), {parents = true}), fs.mkdir(p("x/y/z"), {parents = true}))
print(show(fs.mkdir(p("x"))))
print(show(fs.mkdir(p("q/r"))))
print(show(fs.mkdir(p("a.txt/sub"), {parents = true})))
fs.write(p("x/y/z/deep.txt"), "deep")
fs.write(p("x/b.txt"), "b")
print(fs.symlink("a.txt", p("link")), fs.readlink(p("link")), fs.lstat(p("link")).type, fs.stat(p("link")).type)
print(fs.symlink("nowhere", p("dangling")), fs.exists(p("dangling")), fs.isfile(p("dangling")))
print(string.join(fs.list(d), " "))
print(show(fs.list(p("missing"))))
for _, e in fs.walk(d) do print("  " .. path.relative(d, e)) end
print(len(fs.walk(d, {files = true})), len(fs.walk(d, {max_depth = 1})), len(fs.walk(p("x"))))
print(fs.realpath(p("link")) == fs.realpath(p("a.txt")), show(fs.realpath(p("dangling"))))

print("-- copy, rename, remove")
print(fs.copy(p("x"), p("x2"), {recursive = true}), fs.read(p("x2/y/z/deep.txt")))
print(fs.copy(p("atomic.txt"), p("c.txt")), fs.read(p("c.txt")))
print(show(fs.copy(p("atomic.txt"), p("c.txt"), {overwrite = false})))
print(show(fs.copy(p("x"), p("x3"))))
print(fs.rename(p("c.txt"), p("d.txt")), fs.exists(p("c.txt")), fs.isfile(p("d.txt")))
print(show(fs.rename(p("missing"), p("e.txt"))))
print(show(fs.remove(p("x"))))
print(fs.remove(p("x"), {recursive = true}), fs.exists(p("x")), fs.exists(p("x2")))
print(show(fs.remove(p("missing"))), fs.remove(p("missing"), {force = true}), fs.remove(p("missing"), {recursive = true, force = true}))
print(fs.remove(p("link")), fs.exists(p("link")), fs.exists(p("a.txt")))

print("-- glob, temp files, working directory")
print(show(string.join(fs.glob(d .. "/*.txt"), " ")))
print(len(fs.glob(d .. "/{a,d}.txt")), len(fs.glob(d .. "/nothing*")))
local tf = fs.tempfile("sea-")
print(fs.isfile(tf), fs.stat(tf).size, string.starts_with(path.basename(tf), "sea-"), fs.remove(tf))
local old = fs.cwd()
print(fs.chdir(d), fs.cwd() == fs.realpath(d), fs.read("atomic.txt"), path.abs("a.txt") == path.join(fs.cwd(), "a.txt"))
print(fs.chdir(old), fs.cwd() == old, show(fs.chdir(p("missing"))))
print(fs.remove(d, {recursive = true}), fs.exists(d))

print("-- path")
local cases = {"", ".", "..", "/", "//", "a", "a/", "a/b", "a//b/./c/", "/a/b/../c", "/../a",
               "../../a/b/..", "a/../..", "./a/./b", "/a/b/c/../../..", "a/b.tar.gz", ".bashrc", "/x/.git/"}
for i = 0, len(cases) - 1 do
    local c = cases[i]
    print("[" .. c .. "]", path.normalize(c), path.dirname(c), path.basename(c),
          "[" .. path.ext(c) .. "]", "[" .. path.stem(c) .. "]", string.join(path.parts(c), ","))
end
print(path.join("a", "b", "c"), path.join("a", "/b", "c"), path.join("", "a", ""), "[" .. path.join() .. "]",
      path.join("a/", "../b"), path.join("/", "x"))
print(path.basename("file.txt", ".txt"), path.basename("a/.txt", ".txt"), path.basename("/x/y.tar.gz", ".gz"))
local rel = {{"/a/b", "/a/b/c/d"}, {"/a/b/c", "/a/x"}, {"/a", "/a"}, {"a/b", "a/c"}, {".", "a/b"},
             {"a", "/b"}, {"../a", "b"}, {"/", "/x/y"}, {"a/b", "."}}
for i = 0, len(rel) - 1 do
    local r = path.relative(rel[i][0], rel[i][1])
    print(rel[i][0], rel[i][1], is_error(r) and r.message or r)
end
print(path.sep, path.isabs("/x"), path.isabs("x"), path.isabs(""), path.abs("/a/../b"))
