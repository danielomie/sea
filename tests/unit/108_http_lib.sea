-- Test: libs/http (needs make -C libs/http, libs/ssl and libs/json)
local http = require("../../libs/http/http")

-- server with a router and middleware
local router = http.router()
router.use(function(req, next)
    local resp = next(req)
    if resp.headers == nil then resp.headers = [=] end
    resp.headers["X-Served-By"] = "sea"
    return resp
end)
router.get("/", function(req) return http.text("home") end)
router.get("/users/:id", function(req)
    return http.json({ id = req.params["id"], q = req.query["q"] })
end)
router.post("/echo", function(req)
    return http.text(req.method .. ":" .. req.body .. ":" .. (req.headers["content-type"] or ""))
end)
router.put("/data", function(req)
    local v = req:json()
    return http.json({ sum = v.a + v.b }, 201)
end)
router.get("/cookie", function(req)
    local r = http.text("got " .. tostring(req.cookies["session"]))
    http.set_cookie(r, "session", "abc", { path = "/", http_only = true })
    return r
end)
router.get("/go", function(req) return http.redirect("/") end)
router.get("/nil", function(req) return nil end)
router.get("/crash", function(req)
    local t = nil
    return http.text(t.missing)
end)
router.get("/panic", function(req) panic("handler gave up") end)
router.get("/big", function(req) return http.text(string.rep("x", 100000)) end)

local errors = []
local function on_error(e, req)
    errors[] = req.path .. " " .. (is_error(e) and "runtime error" or tostring(e))
end
local srv = http.listen(0, router, { read_timeout = 2000, on_error = on_error })
local base = "http://127.0.0.1:" .. srv.port

local r = http.get(base .. "/")
print("get:", r.status, r.body, r.headers["x-served-by"], r.ok)
local u = http.get(base .. "/users/a%20b", { query = { q = "x&y" } })
print("params+query:", u:json().id, u:json().q)
print("post:", http.post(base .. "/echo", "hi", "text/plain").body)
local p = http.put(base .. "/data", nil, nil, { json = { a = 2, b = 3 } })
print("put json:", p.status, p:json().sum)
local c = http.get(base .. "/cookie", { headers = { Cookie = "session=xyz" } })
print("cookies:", c.body, c.headers["set-cookie"])
print("redirect:", http.get(base .. "/go").body)
print("no redirect:", http.get(base .. "/go", { follow_redirects = false }).status)
print("405:", http.request("DELETE", base .. "/data").status)
print("404:", http.get(base .. "/missing").status)
local h = http.head(base .. "/big")
print("head:", h.status, len(h.body), h.headers["content-length"])
print("big:", len(http.get(base .. "/big").body))
print("bad handler -> 500:", http.get(base .. "/nil").status)
print("runtime error -> 500:", http.get(base .. "/crash").status)
print("panic -> 500:", http.get(base .. "/panic").status)
print("errors seen:", errors[0], errors[1])
print("server still up:", http.get(base .. "/").body)
print("bad header rejected:", http.get(base .. "/", { headers = { X = "a\r\nb: c" } }).status)

-- concurrent clients (keep-alive pool)
local results = chan(20)
for i = 1, 20 do
    go (function()
        local ok = 0
        for k = 1, 10 do
            if http.get(base .. "/users/" .. i).status == 200 then ok = ok + 1 end
        end
        results <- ok
    end)()
end
local total = 0
for i = 1, 20 do total = total + <-results end
print("concurrent:", total)

-- helpers
print("query:", http.build_query({ b = "x y", a = 1 }), http.parse_query("/p?k=a%26b&f").k)
local pu = http.parse_url("https://[::1]:8443/a/b?c=1#frag")
print("parse_url:", pu.host, pu.port, pu.path, pu.query)
print("encode:", http.url_encode("a b/c"), http.url_decode("a+b%2Fc"))
print("status:", http.status_text(429))

srv.close()
srv.wait()
print("closed:", http.get(base .. "/", { timeout = 500 }).status)

-- gzip: server compresses for clients that accept it; client decodes
local big = string.rep("compress me ", 500)
local gsrv = http.listen(0, function(req) return http.text(big) end, { gzip = true })
local gbase = "http://127.0.0.1:" .. gsrv.port
local g = http.get(gbase .. "/")
print("gzip auto:", len(g.body) == len(big), g.uncompressed, g.headers["vary"])
local graw = http.get(gbase .. "/", { headers = { ["Accept-Encoding"] = "gzip" } })
print("gzip raw:", graw.headers["content-encoding"], len(graw.body) < len(big))
print("gzip refused:", len(http.get(gbase .. "/", { decompress = false }).body))
gsrv.close()
gsrv.wait()

-- streaming: the server sends chunks as it produces them, the client's
-- on_data gets them as they arrive (server-sent events, LLM streams)
local ssrv = http.listen(0, function(req)
    if req.path == "/fail" then return {status = 500, body = "{\"error\": \"nope\"}"} end
    return {
        status = 200,
        headers = {["Content-Type"] = "text/event-stream"},
        stream = function(write)
            for i = 1, 3 do write(`data: ${i}\n\n`) end
            write(string.rep("x", 70000))
        end,
    }
end)
local sbase = "http://127.0.0.1:" .. ssrv.port
local pieces = []
local total = 0
local sr = http.get(sbase .. "/", {on_data = function(p)
    pieces[] = p
    total += len(p)
end})
print("stream:", sr.status, sr.headers["transfer-encoding"], sr.body == "", total, string.sub(pieces[0], 1, 7))
local seen = 0
http.get(sbase .. "/", {on_data = function(p)
    seen += 1
    return false -- stop after the first piece
end})
print("stream stop:", seen)
local fr = http.get(sbase .. "/fail", {on_data = function(p) panic("not for errors") end})
print("stream error body:", fr.status, fr.body)
print("stream again:", http.get(sbase .. "/").body == string.rep("x", 70000) and "bad" or len(http.get(sbase .. "/").body))
ssrv.close()
ssrv.wait()

-- a streaming response through a router (its middlewares copy the
-- response: the stream function has to survive)
local srouter = http.router()
srouter.use(function(req, next) return next(req) end)
srouter.get("/events", function(req)
    return {status = 200, headers = {["Content-Type"] = "text/event-stream"}, stream = function(write)
        write("event: a\n\n")
        write("event: b\n\n")
    end}
end)
local rsrv = http.listen(0, srouter)
local rr = http.get("http://127.0.0.1:" .. rsrv.port .. "/events")
print("router stream:", rr.status, rr.headers["transfer-encoding"], json.encode(rr.body))
rsrv.close()
rsrv.wait()
