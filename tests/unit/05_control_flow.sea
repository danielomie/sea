-- Test: control flow
-- if / elseif / else
local x = 15
if x > 20 then
    print("big")
elseif x > 10 then
    print("medium")
else
    print("small")
end
-- medium

-- while loop
local i = 0
while i < 3 do
    print(i)
    i = i + 1
end
-- 0 1 2

-- break in while
local j = 0
while true do
    j = j + 1
    if j == 3 then break end
end
print(j)    -- 3

-- numeric for
for k = 1, 5 do
    print(k)
end
-- 1 2 3 4 5

-- for with step
for k = 10, 2, -3 do
    print(k)
end
-- 10 7 4

-- break in for
local sum = 0
for n = 1, 100 do
    if n > 5 then break end
    sum = sum + n
end
print(sum)  -- 15
