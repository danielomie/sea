-- Test: the process module (run, spawn, pipes on the netpoller)

print("-- run")
local r = process.run({"echo", "hello", "world"})
print(r.code, r.ok, "[" .. r.stdout .. "]", "[" .. r.stderr .. "]", r.timed_out, r.signal, r.pid > 0)
r = process.run("echo out; echo err 1>&2; exit 3")
print(r.code, r.ok, string.trim(r.stdout), string.trim(r.stderr))
r = process.run({"printf", "%s|%s", "a b", 42})
print(r.stdout)
print(process.run({"cat"}, {stdin = "fed through stdin\n"}).stdout)
print(process.run({"cat"}).stdout == "")                       -- stdin defaults to /dev/null
r = process.run({"sh", "-c", "echo $FOO $NUM; pwd"}, {env = {FOO = "bar", NUM = 42}, cwd = "/"})
print(string.replace(r.stdout, "\n", " "))
r = process.run({"sh", "-c", "echo [${HOME-unset}]"}, {env = {HOME = false}})
print(string.trim(r.stdout))
r = process.run({"/usr/bin/env"}, {clear_env = true, env = {ONLY = "me"}})
print(string.trim(r.stdout))
r = process.run("echo a; echo b 1>&2", {stderr = "stdout"})
print(string.replace(r.stdout, "\n", " "), "[" .. r.stderr .. "]")
r = process.run("echo hidden; echo shown 1>&2", {stdout = "null"})
print("[" .. r.stdout .. "]", string.trim(r.stderr))
print(process.run({"no-such-command-xyz"}))
print(process.run({}))
print(process.run(42))
print(process.run({"echo"}, {stdout = "nowhere"}))

print("-- exit status, signals, timeout")
r = process.run("kill -TERM $$")
print(r.code, r.signal == process.signals.TERM, r.ok)
r = process.run("sleep 5", {timeout = 100})
print(r.timed_out, r.signal == process.signals.KILL, r.ok)

print("-- large data both ways")
r = process.run({"sh", "-c", "head -c 300000 /dev/zero | tr '\\0' x"})
print(len(r.stdout), string.sub(r.stdout, 1, 3))
print(string.trim(process.run({"wc", "-c"}, {stdin = string.rep("y", 200000)}).stdout))

print("-- spawn")
local p = process.spawn({"cat"})
print(p.pid > 0, p:write("line one\r\nline two\npartial"), p:close_stdin())
print(p:read_line(), p:read_line(), p:read_line(), p:read_line())
local st = p:wait()
print(st.code, st.ok, p:wait() == st, p:kill())
local q = process.spawn({"sleep", "10"})
print(q:wait(50), q:kill(process.signals.KILL), q:wait().signal == process.signals.KILL)
local e = process.spawn({"sh", "-c", "echo to-err 1>&2; echo to-out"})
print(string.trim(e:read_stderr()), string.trim(e:read()), e:read(), e:wait().ok)
local w = process.spawn({"sh", "-c", "read x; echo got $x"}, {stderr = "null"})
print(w.stderr, w:write("ping\n"), string.trim(w:read()), w:wait().code)
print(process.spawn({"no-such-command-xyz"}))
print(process.pid() > 0, process.kill(process.pid(), 0), process.signals.INT, process.signals.HUP)

print("-- goroutines keep running while children are waited on")
local ch = chan(3)
for i = 1, 3 do
    go function()
        local rr = process.run({"sh", "-c", "sleep 0.3; echo " .. i})
        ch <- string.trim(rr.stdout)
    end()
end
local t0 = time.now()
local got = []
for i = 1, 3 do got[] = <-ch end
sort.sort(got)
print(string.join(got, ","), time.since(t0) / time.Millisecond < 900)
