-- Test: template strings `text ${expr} text`
local n = 3
local name = "Ana"
print(`total: ${n} items`)
print(`${name}`, type(`${n}`), `plain`, `${n}${n}`, `a${""}b`, len(``))
local t = {x = 1}
print(`x=${t.x}, sum=${n + 2}, call=${string.upper(name)}, nested=${`in ${n}`}`)
print(`braces ${{k = "v"}.k} and str ${"}"} and ${'a\'b'}`)
print(`escapes: \` \${not} tab\tend \x41\u{E9}`)
print(`multi
line ${n}`)
print(`${nil} ${true} ${1.5} ${[1, 2][1]} ${name:lower()}`)
-- each loop iteration's value
local fs = []
for i = 1, 3 do fs[] = function() return `i=${i}` end end
print(fs[0](), fs[2]())
-- a runtime error inside ${} points at its line
local function try(f)
    local err = nil
    local function run()
        defer function() err = recover() end
        f()
    end
    run()
    return err
end
local e = try(function()
    local none = nil
    return `first line
${none.field}`
end)
print("error at line", re.match(":(\\d+):", e.message).groups[1])

-- syntax errors
local parser = require("sea/parser")
local function check(src)
    local d = parser.check(src, {name = "t.sea"})
    return d == nil and "ok" or d.text
end
print(check("local s = `abc"))
print(check("local s = `a ${} b`"))
print(check("local s = `a ${1 2} b`"))
print(check("local s = `bad \\q`"))
print(check("local s = `x\n${y +}`"))

-- the tree and the formatter
local node = parser.parse("local s = `a ${x} b\\n`").stmts[0].values[0]
print(node.type, len(node.parts), node.exprs[0].name, node.raws[1])
print(parser.format("local s=`v=${ a+1 } \\` ok`"))
print(parser.format({type = "template", parts = ["x `q` ${", "!"], exprs = [{type = "ident", name = "v"}]}))
