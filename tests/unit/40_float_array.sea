-- Test: float_array — typed float array without per-element RC

local a = float_array(4)
print(type(a))        -- float_array
print(len(a))         -- 0

a[] = 1.5
a[] = 2.5
a[] = 3.5
print(len(a))         -- 3
print(a[0])           -- 1.5
print(a[1])           -- 2.5
print(a[2])           -- 3.5

-- negative index
print(a[-1])          -- 3.5
print(a[-3])          -- 1.5

-- set
a[1] = 9.9
print(a[1])           -- 9.9

-- out-of-bounds returns 0.0
print(a[100])         -- 0

-- large fill (tests growth)
local b = float_array(2)
local i = 0
while i < 50 do
    b[] = i * 0.1
    i = i + 1
end
print(len(b))         -- 50
print(b[0])           -- 0
