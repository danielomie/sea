-- Test: advanced defer behavior

-- 1. Multiple defers in one function run in LIFO order
local log = []
local function log_add(v) log[] = v end

local function multi_defer()
    defer log_add("first")
    defer log_add("second")
    defer log_add("third")
    log[] = "body"
end

multi_defer()
assert(log[0] == "body",   "body should be first")
assert(log[1] == "third",  "third deferred runs first (LIFO)")
assert(log[2] == "second", "second deferred runs second")
assert(log[3] == "first",  "first deferred runs last")

-- 2. Defer executes even on early return
local cleaned = false

local function early_return(x)
    defer (function() cleaned = true end)()
    if x < 0 then
        return "negative"
    end
    return "positive"
end

local r1 = early_return(-5)
assert(r1 == "negative", "early return value wrong")
assert(cleaned == true, "defer must run on early return")

cleaned = false
local r2 = early_return(5)
assert(r2 == "positive", "normal return value wrong")
assert(cleaned == true, "defer must run on normal return")

-- 3. Defers are scoped per-function (inner defer runs before outer body continues)
local seq = []
local function seq_add(v) seq[] = v end

local function inner()
    defer seq_add("inner-defer")
    seq[] = "inner-body"
end

local function outer()
    defer seq_add("outer-defer")
    seq[] = "outer-before"
    inner()
    seq[] = "outer-after"
end

outer()
assert(seq[0] == "outer-before", "outer-before")
assert(seq[1] == "inner-body",   "inner-body")
assert(seq[2] == "inner-defer",  "inner-defer runs before returning to outer")
assert(seq[3] == "outer-after",  "outer-after")
assert(seq[4] == "outer-defer",  "outer-defer runs last")

-- 4. Defer captures upvalue by reference (closure semantics)
local captured_val = 0

local function defer_closure()
    local x = 1
    defer (function()
        captured_val = x
    end)()
    x = 99   -- mutate x after defer registration
end

defer_closure()
assert(captured_val == 99, "defer closure sees latest value of upvalue")

print("PASS: defer advanced")
