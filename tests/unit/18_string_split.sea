-- Test: string split and advanced string ops
-- split by comma
local parts = string.split("a,b,c,d", ",")
for i, v in parts do
    print(v)
end
-- a
-- b
-- c
-- d

-- split by multi-char separator
local words = string.split("hello world foo", " ")
for i, v in words do
    print(v)
end
-- hello
-- world
-- foo

-- split empty string
local empty = string.split("", ",")
print(len(empty))   -- 0

-- split with no separator found (returns full string)
local one = string.split("hello", ",")
print(len(one))     -- 1
print(one[0])       -- hello

-- string.sub edge cases
local s = "hello"
print(string.sub(s, -3))      -- llo
print(string.sub(s, -3, -1))  -- llo
print(string.sub(s, 1, -1))   -- hello
print(string.sub(s, 2, -2))   -- ell

-- string.find with init
local t = "abcabc"
print(string.find(t, "bc"))      -- 2
print(string.find(t, "bc", 3))   -- 5
print(string.find(t, "xyz"))     -- nil
