-- Test: math library
print(math.abs(-5))       -- 5
print(math.abs(5))        -- 5
print(math.floor(3.7))    -- 3
print(math.floor(-3.7))   -- -4
print(math.ceil(3.2))     -- 4
print(math.ceil(-3.2))    -- -3
print(math.round(3.5))    -- 4
print(math.round(3.4))    -- 3
print(math.sqrt(25))      -- 5
print(math.sqrt(2) > 1.4 and math.sqrt(2) < 1.5)  -- true
print(math.pow(2, 10))    -- 1024
print(math.max(1, 5, 3, 2, 4))  -- 5
print(math.min(1, 5, 3, 2, 4))  -- 1
print(math.trunc(3.9))    -- 3
print(math.trunc(-3.9))   -- -3

-- constants
print(math.pi > 3.14 and math.pi < 3.15)  -- true

-- integer math ops
print(2 ^ 8)    -- 256
print(10 // 3)  -- 3
print(10 % 3)   -- 1
print(-10 % 3)  -- 2  (floored modulo)

-- log and exp
print(math.exp(0))   -- 1
print(math.log(1))   -- 0
print(math.floor(math.log(math.exp(5)) + 0.5))  -- 5

-- NaN is a number, not nil (x86 produces the nil bit pattern for 0/0)
local zero = 0
local nan = zero / zero
print(type(nan), isnan(nan), nan ~= nil, type(math.huge - math.huge))

-- // and % round toward minus infinity, whether the compiler folds the
-- constants or not (folding used C's truncating / and %)
local na, nb = -7, 2
local function divmod(x, y) return x // y, x % y end
local dq, dr = divmod(-7, 2)
print(-7 // 2, -7 % 2, na // nb, na % nb, dq, dr, 7 // -2, 7 % -2)
