-- Test: int_array — typed integer array without per-element RC

local a = int_array(4)
print(type(a))        -- int_array
print(len(a))         -- 0

a[] = 10
a[] = 20
a[] = 30
print(len(a))         -- 3
print(a[0])           -- 10
print(a[1])           -- 20
print(a[2])           -- 30

-- negative index
print(a[-1])          -- 30
print(a[-3])          -- 10

-- set
a[1] = 99
print(a[1])           -- 99

-- out-of-bounds returns 0
print(a[100])         -- 0

-- large fill (tests growth)
local b = int_array(2)
local i = 0
while i < 100 do
    b[] = i
    i = i + 1
end
print(len(b))         -- 100
print(b[0])           -- 0
print(b[99])          -- 99
