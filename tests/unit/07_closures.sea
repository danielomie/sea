-- Test: closures and upvalues
-- basic closure (counter)
local function make_counter()
    local n = 0
    return function()
        n = n + 1
        return n
    end
end

local c1 = make_counter()
local c2 = make_counter()
print(c1())  -- 1
print(c1())  -- 2
print(c2())  -- 1
print(c1())  -- 3

-- shared upvalue between two closures
local function shared_state()
    local val = 0
    local function set(x) val = x end
    local function get() return val end
    return set, get
end

local s, g = shared_state()
print(g())   -- 0
s(42)
print(g())   -- 42

-- closure over loop variable
local funcs = {}
for i = 1, 3 do
    local j = i
    funcs[i-1] = function() return j end
end
print(funcs[0]())  -- 1
print(funcs[1]())  -- 2
print(funcs[2]())  -- 3

-- self-referential local function
local function fib(n)
    if n <= 1 then return n end
    return fib(n - 1) + fib(n - 2)
end
print(fib(10))  -- 55
