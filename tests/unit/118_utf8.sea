-- Test: the utf8 module and UTF-8 source rules (\u{} escapes, invalid
-- bytes rejected by the lexer, byte-order mark skipped)

local s = "Ação é ÇÃO! 日本語 😀"

print("-- length and validity")
print(utf8.len(s), len(s), utf8.valid(s), utf8.invalid(s))
print(utf8.len(""), utf8.valid(""))

print("-- case mapping")
print(utf8.upper(s))
print(utf8.lower("ÁÉÍÓÚ ÀÈ ÇÑ ĞŞİ ΑΒΓΣ ΆΈ ПРИВЕТ Ёё ẞ Ŷ Ǎ Ț Ա"))
print(utf8.upper("áéíóú àè çñ ğşı αβγς άέ привет ёё ŷ ǎ ț ա"))
print(utf8.upper("ß ÿ ſ µ straße"))

print("-- substrings and positions")
print(utf8.sub(s, 1, 4), utf8.sub(s, -5), utf8.sub(s, 6, 6), "[" .. utf8.sub(s, 100) .. "]", "[" .. utf8.sub(s, 3, 2) .. "]")
print(utf8.sub(s, -100, 2), utf8.sub(s, 1) == s)
print(utf8.offset(s, 1), utf8.offset(s, 3), utf8.offset(s, -1), utf8.offset(s, utf8.len(s) + 1), len(s) + 1, utf8.offset(s, 99))
print(string.sub(s, utf8.offset(s, 14), utf8.offset(s, 17) - 1))

print("-- code points and characters")
print(utf8.codepoint("€"), utf8.codepoint(s, 2), utf8.codepoint(s, -1), utf8.codepoint(s, 100), utf8.codepoint(""))
print(utf8.char(72, 0xE9, 0x1F600), utf8.char(), utf8.char(utf8.codepoints("olá")))
local cps = utf8.codepoints("añ😀")
print(len(cps), cps[0], cps[1], cps[2])
print(string.join(utf8.chars("añ日😀"), "|"), len(utf8.chars("")))
print(utf8.reverse("abç日😀"), utf8.reverse(""))
local function try(f)
    local result = nil
    local function run()
        defer function()
            local e = recover()
            if e != nil then result = string.sub(e.message, string.find(e.message, ": utf8.") + 2) end
        end
        f()
    end
    run()
    return result
end
print(try(function() local _ = utf8.char(0xD800) end))
print(try(function() local _ = utf8.char(0x110000) end))
print(try(function() local _ = utf8.len(42) end))
print(try(function() local _ = utf8.sub("x", "a") end))

print("-- terminal width")
print(utf8.width("abc"), utf8.width("日本語"), utf8.width("e\u{301}"), utf8.width("😀!"), utf8.width("ｆｕｌｌ"), utf8.width("a\tb"))

print("-- invalid bytes")
local bad = "ok" .. string.char(0xFF) .. "x" .. string.char(0xC3)
print(utf8.valid(bad), utf8.invalid(bad), utf8.len(bad), utf8.sanitize(bad), utf8.sanitize(bad, "?"))
print(utf8.sanitize("fine") == "fine", utf8.upper(bad) == "OK" .. string.char(0xFF) .. "X" .. string.char(0xC3))
print(utf8.valid(string.char(0xC0, 0x80)), utf8.valid(string.char(0xED, 0xA0, 0x80)), utf8.valid(string.char(0xF4, 0x90, 0x80, 0x80)))
print(string.join(utf8.chars("a" .. string.char(0xE2, 0x82) .. "b"), ","))

print("-- \\u{} escapes")
print("\u{48}\u{e9}\u{20AC}\u{1F600}", "\u{10FFFF}" == utf8.char(0x10FFFF), len("\u{0}"))
print("caf\u{E9}" == "café", 'single \u{2713}')
-- a literal keeps NUL bytes (it used to stop at the first one)
local nul = "a\0b\u{0}c"
print(len(nul), string.byte(nul, 2), string.byte(nul, 4), nul == "a\0b\u{0}c", nul == "a")

print("-- source must be UTF-8")
local parser = require("sea/parser")
local function check(src)
    local r = parser.parse(src)
    print(is_error(r) and r.message or "ok")
end
check("local s = \"caf" .. string.char(0xE9) .. "\"")
check("x = 1\n-- coment" .. string.char(0xE1) .. "rio\ny = 2")
check("x = \"\\u{D800}\"")
check("x = \"\\u00e9\"")
check("x = \"\\u{110000}\"")
check("x = \"\\u{}\"")
check(string.char(0xEF, 0xBB, 0xBF) .. "x = \"bom\"")
