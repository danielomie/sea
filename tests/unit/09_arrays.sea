-- Test: arrays (native [] syntax)
local a = []
a[] = 10
a[] = 20
a[] = 30
print(len(a))   -- 3
print(a[0])     -- 10
print(a[1])     -- 20
print(a[2])     -- 30

-- remove last element
local last = a[len(a)-1]
del a[len(a)-1]
print(last)     -- 30
print(len(a))   -- 2

-- for-in over array
local b = []
b[] = "x"
b[] = "y"
b[] = "z"
for i, v in b do
    print(i, v)
end
-- 0	x
-- 1	y
-- 2	z

-- pre-allocated array
local c = [10]
c[] = 1
c[] = 2
print(len(c))   -- 2
print(c[0])     -- 1
print(c[1])     -- 2

-- negative index access
print(b[-1])    -- z
print(b[-2])    -- y

-- replace at index
a[] = 99
a[0] = 42
print(a[0])     -- 42
print(a[1])     -- 99

-- del removes at index and shifts
local d = []
d[] = "a"
d[] = "b"
d[] = "c"
del d[1]
print(len(d))   -- 2
print(d[0])     -- a
print(d[1])     -- c
