-- Test: channels

-- 1. Buffered channel: send and receive without blocking
local ch = chan(4)
ch <- 10
ch <- 20
ch <- 30
ch <- 40

assert(<-ch == 10, "buffered recv 1")
assert(<-ch == 20, "buffered recv 2")
assert(<-ch == 30, "buffered recv 3")
assert(<-ch == 40, "buffered recv 4")

-- 2. Buffered channel preserves FIFO order
local fifo = chan(5)
for i = 1, 5 do
    fifo <- i
end
for i = 1, 5 do
    local v = <-fifo
    assert(v == i, "FIFO order violated")
end

-- 3. close() and for-in over channel
local src = chan(3)
src <- 100
src <- 200
src <- 300
close(src)

local items = []
for v in src do
    items[] = v
end
assert(len(items) == 3, "should receive exactly 3 items")
assert(items[0] == 100, "item 0")
assert(items[1] == 200, "item 1")
assert(items[2] == 300, "item 2")

-- 4. chan(0) creates an unbuffered channel; goroutine needed for handshake
local unbuf = chan(0)
go (function()
    unbuf <- 777
end)()
local got = <-unbuf
assert(got == 777, "unbuffered channel handshake")

-- 5. type() of a channel
assert(type(chan(1)) == "channel", "type of channel is 'channel'")

-- 6. Multiple sends and receives in a loop
local pipe = chan(10)
local wg = sync.waitgroup()
wg.add(wg, 1)

go (function()
    local total = 0
    for i = 0, 9 do
        total = total + (<-pipe)
    end
    pipe <- total
    wg.done(wg)
end)()

for i = 0, 9 do
    pipe <- i
end
wg.wait(wg)
local total_result = <-pipe
assert(total_result == 45, "sum of 0..9 = 45")

print("PASS: channels")
