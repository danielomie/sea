-- Test: comprehensive integration test
-- Implements several algorithms to exercise all language features together

-- 1. Binary search
local function binary_search(arr, target)
    local lo, hi = 0, len(arr) - 1
    while lo <= hi do
        local mid = (lo + hi) // 2
        local val = arr[mid]
        if val == target then
            return mid
        elseif val < target then
            lo = mid + 1
        else
            hi = mid - 1
        end
    end
    return -1
end

local sorted = {1, 3, 5, 7, 9, 11, 13, 15}
print(binary_search(sorted, 7))    -- 3
print(binary_search(sorted, 1))    -- 0
print(binary_search(sorted, 15))   -- 7
print(binary_search(sorted, 4))    -- -1

-- 2. String processing: count word frequencies
local function word_count(text)
    local words = string.split(text, " ")
    local counts = {}
    for i, word in words do
        if counts[word] == nil then
            counts[word] = 0
        end
        counts[word] = counts[word] + 1
    end
    return counts
end

local freq = word_count("the cat sat on the mat the cat")
print(freq["the"])  -- 3
print(freq["cat"])  -- 2
print(freq["sat"])  -- 1
print(freq["mat"])  -- 1

-- 3. Merge sort
local function merge_sort(arr)
    local n = len(arr)
    if n <= 1 then return arr end
    local mid = n // 2
    local left = {}
    local right = {}
    for i = 0, mid - 1 do
        left[i] = arr[i]
    end
    for i = mid, n - 1 do
        right[i - mid] = arr[i]
    end
    left = merge_sort(left)
    right = merge_sort(right)
    -- merge
    local result = {}
    local li, ri, idx = 0, 0, 0
    local ln = len(left)
    local rn = len(right)
    while li < ln and ri < rn do
        if left[li] <= right[ri] then
            result[idx] = left[li]
            li = li + 1
        else
            result[idx] = right[ri]
            ri = ri + 1
        end
        idx = idx + 1
    end
    while li < ln do
        result[idx] = left[li]
        li = li + 1
        idx = idx + 1
    end
    while ri < rn do
        result[idx] = right[ri]
        ri = ri + 1
        idx = idx + 1
    end
    return result
end

local unsorted = {5, 2, 8, 1, 9, 3, 7, 4, 6}
local sorted2 = merge_sort(unsorted)
local out = ""
for i = 0, len(sorted2) - 1 do
    if i > 0 then out = out .. " " end
    out = out .. sorted2[i]
end
print(out)  -- 1 2 3 4 5 6 7 8 9

-- 4. Closure-based event system
local function make_emitter()
    local handlers = {}
    return {
        on = function(event, fn)
            if handlers[event] == nil then
                handlers[event] = []
            end
            handlers[event][] = fn
        end,
        emit = function(event, data)
            if handlers[event] == nil then return end
            for i, fn in handlers[event] do
                fn(data)
            end
        end
    }
end

local emitter = make_emitter()
local log = []
emitter.on("data", function(x) log[] = x * 2 end)
emitter.on("data", function(x) log[] = x + 10 end)
emitter.emit("data", 5)
print(log[0])  -- 10  (5*2)
print(log[1])  -- 15  (5+10)
emitter.emit("data", 3)
print(log[2])  -- 6   (3*2)
print(log[3])  -- 13  (3+10)
