-- libs/duckdb/duckdb.sea — DuckDB (embedded analytical SQL) for Sea
--
-- Build first:  make -C libs/duckdb   (downloads libduckdb into vendor/)
-- Usage:        local duckdb = require("../libs/duckdb/duckdb")
--
--   local db = duckdb.open("data.duckdb")?        -- nil or ":memory:" for in-memory
--   local _ = db:exec("CREATE TABLE t (id INTEGER, name VARCHAR)")?
--   local n = db:exec("INSERT INTO t VALUES (?, ?)", 1, "ana")?        -- rows changed
--   for _, row in db:query("SELECT * FROM t WHERE id > ?", 0)? do print(row.name) end
--   db:close()
--
-- Failures are error values (is_error(e), e.message). Parameters are values
-- after the SQL (`?` / `$1`), one positional table {a, b}, or a table of
-- named values {name = v} for `$name`. In a goroutine a query runs on a
-- worker thread and only that goroutine waits.

local native = require("duckdb_native")

local M = {}

local Conn = {}
local Stmt = {}
local Appender = {}

local function with_methods(obj, methods)
    for k, f in methods do obj[k] = f end
    return obj
end

local function new_conn(h, db_handle, owns_db)
    local c = {}
    c.handle = h
    c.db_handle = db_handle
    c.owns_db = owns_db
    return with_methods(c, Conn)
end

-- duckdb.version() → "v1.5.6"
function M.version()
    return native.version()
end

-- duckdb.open([path [, opts]]) → db | error
-- opts: read_only (bool), threads, memory_limit ("2GB"), and any DuckDB
-- configuration option by name (values are converted to strings).
function M.open(path, opts)
    local dbh = native.open(path, opts)
    if is_error(dbh) then return dbh end
    local h = native.connect(dbh)
    if is_error(h) then
        native.close(dbh)
        return h
    end
    return new_conn(h, dbh, true)
end

-- ---- connections (a database is its first connection) ----------------------

-- db:query(sql, params...) → array of rows (tables keyed by column name)
function Conn.query(self, sql, ...)
    return native.run(self.handle, sql, "rows", nil, ...)
end

-- db:exec(sql, params...) → number of rows changed. Without parameters the
-- SQL may hold several statements separated by ';'.
function Conn.exec(self, sql, ...)
    return native.run(self.handle, sql, "exec", nil, ...)
end

-- db:row(sql, params...) → the first row, or nil
function Conn.row(self, sql, ...)
    return native.run(self.handle, sql, "row", nil, ...)
end

-- db:value(sql, params...) → the first column of the first row, or nil
function Conn.value(self, sql, ...)
    return native.run(self.handle, sql, "value", nil, ...)
end

-- db:columns(sql, params...) → {names, types, count, data = {column = values}}
-- Integer columns without NULLs come as int_array, floating/decimal ones as
-- float_array, the rest as arrays.
function Conn.columns(self, sql, ...)
    return native.run(self.handle, sql, "columns", nil, ...)
end

-- db:each(sql, fn, params...) → rows seen; fn(row) returning false stops
function Conn.each(self, sql, fn, ...)
    return native.run(self.handle, sql, "each", fn, ...)
end

-- db:prepare(sql) → stmt | error
function Conn.prepare(self, sql)
    local h = native.prepare(self.handle, sql)
    if is_error(h) then return h end
    local s = {}
    s.handle = h
    s.sql = sql
    s.params = native.params(h)
    return with_methods(s, Stmt)
end

-- db:appender(table [, schema]) → appender | error  (fast bulk insert)
function Conn.appender(self, table, schema)
    local h = native.appender(self.handle, table, schema)
    if is_error(h) then return h end
    local a = {}
    a.handle = h
    a.table = table
    return with_methods(a, Appender)
end

-- db:connect() → another connection to the same database (for goroutines
-- that query in parallel: one connection runs one query at a time)
function Conn.connect(self)
    local h = native.connect(self.db_handle)
    if is_error(h) then return h end
    return new_conn(h, self.db_handle, false)
end

-- db:transaction(fn) → what fn returns | error. Commits when fn returns;
-- rolls back when it returns an error value or panics (the panic goes on).
function Conn.transaction(self, fn)
    local began = self:exec("BEGIN TRANSACTION")
    if is_error(began) then return began end
    local done = false
    local result = nil
    local function body()
        defer function()
            if not done then self:exec("ROLLBACK") end
        end
        result = fn(self)
        if not is_error(result) then done = true end
    end
    body()
    if not done then return result end
    local committed = self:exec("COMMIT")
    if is_error(committed) then return committed end
    return result
end

-- db:interrupt(): stop the query running on this connection (from another goroutine)
function Conn.interrupt(self)
    return native.interrupt(self.handle)
end

-- db:close(): closing the database closes all its connections, statements
-- and appenders; closing a connection from db:connect() closes only it
function Conn.close(self)
    if self.owns_db then return native.close(self.db_handle) end
    return native.close(self.handle)
end

-- ---- prepared statements -------------------------------------------------------

function Stmt.query(self, ...)
    return native.run(self.handle, nil, "rows", nil, ...)
end

function Stmt.exec(self, ...)
    return native.run(self.handle, nil, "exec", nil, ...)
end

function Stmt.row(self, ...)
    return native.run(self.handle, nil, "row", nil, ...)
end

function Stmt.value(self, ...)
    return native.run(self.handle, nil, "value", nil, ...)
end

function Stmt.columns(self, ...)
    return native.run(self.handle, nil, "columns", nil, ...)
end

function Stmt.each(self, fn, ...)
    return native.run(self.handle, nil, "each", fn, ...)
end

function Stmt.close(self)
    return native.close(self.handle)
end

-- ---- appenders -------------------------------------------------------------------

-- app:append(row) → 1 | error: row is a sequence in column order, or a table
-- by column name (absent columns get their default)
function Appender.append(self, row)
    return native.append(self.handle, row, false)
end

-- app:append_rows(rows) → number of rows | error
function Appender.append_rows(self, rows)
    return native.append(self.handle, rows, true)
end

-- app:flush() → true | error: write the buffered rows to the table
function Appender.flush(self)
    return native.flush(self.handle)
end

-- app:close() → true | error: flush, then free the appender
function Appender.close(self)
    local flushed = native.flush(self.handle)
    native.close(self.handle)
    if is_error(flushed) then return flushed end
    return true
end

return M
