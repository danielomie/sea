-- libs/smtp tests: bin/sea test libs/smtp (against a fake server in a goroutine)

local t = require("sea/test")
local smtp = require("./smtp")

-- a fake SMTP server for one connection: opts.auth ("PLAIN LOGIN", "LOGIN"),
-- opts.starttls (offer it), opts.refuse (addresses RCPT refuses). Each
-- session's commands and messages go to the channel when it ends.
local function server(opts)
    opts = opts or {}
    local fd = t.no_error(net.listen(0, "127.0.0.1"))
    local port = net.local_port(fd)
    local got = chan(4)
    go function()
        local conn = net.accept(fd, 10000)
        if is_error(conn) then return end
        local buf = ""
        local function line()
            while not string.contains(buf, "\r\n") do
                local c = net.read(conn, 4096, 10000)
                if is_error(c) or c == "" then return nil end
                buf ..= c
            end
            local i = string.find(buf, "\r\n")
            local l = string.sub(buf, 1, i - 1)
            buf = string.sub(buf, i + 2)
            return l
        end
        local s = {}
        s.cmds = []
        s.messages = []
        net.write(conn, "220 fake ESMTP\r\n")
        while true do
            local l = line()
            if l == nil then break end
            s.cmds[] = l
            local u = string.upper(l)
            if string.starts_with(u, "EHLO") then
                local ext = ["250-fake"]
                if opts.starttls then ext[] = "250-STARTTLS" end
                ext[] = "250-SIZE 1000000"
                ext[] = "250 AUTH " .. (opts.auth or "PLAIN LOGIN")
                net.write(conn, string.join(ext, "\r\n") .. "\r\n")
            elseif string.starts_with(u, "AUTH PLAIN") then
                net.write(conn, "235 ok\r\n")
            elseif u == "AUTH LOGIN" then
                net.write(conn, "334 VXNlcm5hbWU6\r\n")
                s.cmds[] = line()
                net.write(conn, "334 UGFzc3dvcmQ6\r\n")
                s.cmds[] = line()
                net.write(conn, "235 ok\r\n")
            elseif string.starts_with(u, "MAIL") or u == "RSET" then
                net.write(conn, "250 ok\r\n")
            elseif string.starts_with(u, "RCPT") then
                local to = re.match("<([^>]+)>", l).groups[1]
                if list.contains(opts.refuse or [], to) then net.write(conn, "550 no such user\r\n")
                else net.write(conn, "250 ok\r\n") end
            elseif u == "DATA" then
                net.write(conn, "354 go\r\n")
                local data = []
                while true do
                    local d = line()
                    if d == nil or d == "." then break end
                    data[] = d
                end
                s.messages[] = string.join(data, "\r\n")
                net.write(conn, "250 queued\r\n")
            elseif u == "QUIT" then
                net.write(conn, "221 bye\r\n")
                break
            else
                net.write(conn, "502 ?\r\n")
            end
        end
        got <- s
        net.close(conn)
        net.close(fd)
    end()
    return `127.0.0.1:${port}`, got
end

t.describe("smtp", function()
    t.it("parses URLs", function()
        local u = smtp.parse_url("smtps://ana%40x.com:s%3Agredo@mail.x.com")
        t.eq(u.secure, true)
        t.eq(u.port, 465)
        t.eq(u.user, "ana@x.com")
        t.eq(u.pass, "s:gredo")
        t.eq(smtp.parse_url("smtp://h").port, 587)
        t.eq(smtp.parse_url("smtp://h:2525?tls=none").plain, true)
        t.is_error(smtp.parse_url("http://x"), "URL")
        t.eq(smtp.address("Ana Lima <ana@x.com>"), "ana@x.com")
        t.eq(smtp.address(" ana@x.com "), "ana@x.com")
    end)

    t.it("writes a MIME message: accents, HTML, attachments, no Bcc", function()
        local m = smtp.message({from = "Loja São Jorge <loja@x.com>", to = ["ana@x.com"], cc = "bia@x.com",
            bcc = ["oculto@x.com"], reply_to = "sac@x.com", subject = "Pedido nº 12", text = "Olá", html = "<p>Olá</p>",
            attachments = [{filename = "pedido.csv", content = "a;b\n", type = "text/csv"}], headers = {["X-Tag"] = "teste"}})
        t.contains(m, "From: =?UTF-8?B?" .. encoding.base64_encode("Loja São Jorge") .. "?= <loja@x.com>")
        t.contains(m, "Cc: bia@x.com")
        t.contains(m, "Reply-To: sac@x.com")
        t.contains(m, "Subject: =?UTF-8?B?" .. encoding.base64_encode("Pedido nº 12") .. "?=")
        t.contains(m, "X-Tag: teste")
        t.contains(m, "multipart/mixed")
        t.contains(m, "multipart/alternative")
        t.contains(m, encoding.base64_encode("<p>Olá</p>"))
        t.contains(m, "filename=\"pedido.csv\"")
        t.no(string.contains(m, "oculto"))
    end)

    t.it("puts an image inline in the HTML (cid), and the other files as attachments", function()
        local m = smtp.message({from = "loja@x.com", to = "ana@x.com", subject = "Pix", text = "Pague", html = "<img src=\"cid:qr\">",
            attachments = [{filename = "qr.png", content = "PNG", type = "image/png", cid = "qr"},
                {filename = "boleto.pdf", content = "PDF", type = "application/pdf"}]})
        t.contains(m, "multipart/mixed")
        t.contains(m, "multipart/related")
        t.contains(m, "Content-ID: <qr>")
        t.contains(m, "Content-Disposition: inline; filename=\"qr.png\"")
        t.contains(m, "Content-Disposition: attachment; filename=\"boleto.pdf\"")
        -- the related part (the HTML and its image) comes before the files
        t.ok(string.find(m, "multipart/related") < string.find(m, "boleto.pdf"))
        -- without HTML, an inline image goes as a file
        local plain = smtp.message({from = "loja@x.com", to = "ana@x.com", subject = "Pix", text = "Pague",
            attachments = [{filename = "qr.png", content = "PNG", type = "image/png", cid = "qr"}]})
        t.no(string.contains(plain, "multipart/related"))
        t.contains(plain, "Content-Disposition: attachment; filename=\"qr.png\"")
    end)

    t.it("sends: AUTH PLAIN, every recipient, dot-stuffing", function()
        local addr, got = server()
        local r = t.no_error(smtp.send(`smtp://ana%40x.com:segredo@${addr}?tls=none`, {from = "Loja <loja@x.com>",
            to = "ana@x.com", bcc = ["oculto@x.com"], subject = "Oi", text = "linha\n.começa com ponto"}))
        t.eq(r.accepted, ["ana@x.com", "oculto@x.com"])
        t.eq(r.rejected, [])
        local s = <-got
        t.eq(s.cmds[0], "EHLO localhost")
        t.eq(s.cmds[1], "AUTH PLAIN " .. encoding.base64_encode("\0ana@x.com\0segredo"))
        t.eq(s.cmds[2], "MAIL FROM:<loja@x.com>")
        t.eq(s.cmds[len(s.cmds) - 1], "QUIT")
        t.contains(s.messages[0], "Message-ID: " .. r.id)
        -- the text is base64, so no line of it starts with a dot; the server
        -- sees a dot-stuffed message only where one does
        t.no(re.match("(?m)^\\.[^.]", s.messages[0]) ~= nil)
    end)

    t.it("logs in with AUTH LOGIN when that is all the server offers", function()
        local addr, got = server({auth = "LOGIN"})
        t.no_error(smtp.send(`smtp://ana:segredo@${addr}?tls=none`, {from = "a@x.com", to = "b@x.com", text = "x"}))
        local s = <-got
        t.eq(s.cmds[1], "AUTH LOGIN")
        t.eq(s.cmds[2], encoding.base64_encode("ana"))
        t.eq(s.cmds[3], encoding.base64_encode("segredo"))
    end)

    t.it("reports refused recipients, and fails only when all are", function()
        local addr, got = server({refuse = ["nao@x.com"]})
        local c = t.no_error(smtp.dial(`smtp://${addr}?tls=none`, {helo = "loja.x.com"}))
        local r = t.no_error(c:send({from = "a@x.com", to = ["b@x.com", "nao@x.com"], text = "x"}))
        t.eq(r.accepted, ["b@x.com"])
        t.eq(r.rejected[0].address, "nao@x.com")
        t.contains(r.rejected[0].error, "550")
        -- the same connection, the next message
        t.is_error(c:send({from = "a@x.com", to = "nao@x.com", text = "x"}), "every recipient was refused")
        c:close()
        local s = <-got
        t.eq(s.cmds[0], "EHLO loja.x.com")
        t.eq(len(s.messages), 1)
    end)

    t.it("refuses a server without STARTTLS, unless asked for plain text", function()
        local addr, got = server()
        t.is_error(smtp.send(`smtp://${addr}`, {from = "a@x.com", to = "b@x.com", text = "x"}), "STARTTLS")
        local s = <-got
        t.eq(s.cmds[len(s.cmds) - 1], "QUIT")
        t.is_error(smtp.send("smtp://127.0.0.1:1?tls=none", {from = "a@x.com", to = "b@x.com"}))
    end)
end)
