-- smtp — sending e-mail: an SMTP client over the net module and libs/ssl
--
--   local smtp = require("smtp")
--   local r = smtp.send("smtps://user:pass@smtp.example.com", {
--       from = "Loja <no-reply@example.com>", to = ["ana@example.com"],
--       subject = "Seu pedido", text = "Olá!", html = "<p>Olá!</p>",
--       attachments = [{filename = "pedido.csv", content = bytes, type = "text/csv"}],
--   })?
--   print(r.id, r.accepted)
--
-- URLs: smtps:// (TLS from the start, port 465), smtp:// (STARTTLS, port
-- 587: refused if the server does not offer it), smtp://...?tls=none (plain
-- text: only for a local test server). user:pass (URL-encoded) log in with
-- AUTH PLAIN, or LOGIN when that is all the server offers.
--
-- Every wait goes through the netpoller: a send parks only its goroutine.

local ssl = require("../ssl/ssl")

local M = {}

M.TIMEOUT = 20000

-- smtp.parse_url(url) → {secure, plain, host, port, user, pass} | error
function M.parse_url(url)
    local m = re.match("^(smtps?)://(?:([^:@/]*)(?::([^@/]*))?@)?([^:/?]+)(?::(\\d+))?/?(\\?.*)?$", url or "")
    if m == nil then return error("smtp: the URL is smtp[s]://[user:pass@]host[:port][?tls=none]") end
    local g = m.groups
    local out = {}
    out.secure = g[1] == "smtps"
    out.plain = g[6] ~= nil and string.contains(g[6], "tls=none")
    out.host = g[4]
    out.port = g[5] ~= nil and tonumber(g[5]) or (out.secure and 465 or 587)
    out.user = g[2] ~= nil and g[2] ~= "" and encoding.url_decode(g[2]) or nil
    out.pass = g[3] ~= nil and encoding.url_decode(g[3]) or nil
    return out
end

-- ---- the message ----

-- RFC 2047: a header with accents goes as base64 words
local function encode_header(s)
    if re.match("^[\\x20-\\x7e]*$", s) ~= nil then return s end
    return "=?UTF-8?B?" .. encoding.base64_encode(s) .. "?="
end

-- "Ana Lima <ana@x.com>" → the name encoded, the address as is
local function encode_address(s)
    local m = re.match("^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>\\s*$", s)
    if m == nil or m.groups[1] == "" then return string.trim(s) end
    return `${encode_header(m.groups[1])} <${m.groups[2]}>`
end

-- smtp.address(s) → the bare address of "Name <a@b.com>" or "a@b.com"
function M.address(s)
    local m = re.match("<([^>]+)>", s)
    return m ~= nil and m.groups[1] or string.trim(s)
end

local function list_of(x)
    if x == nil then return [] end
    if type(x) == "string" then return [x] end
    return x
end

local function wrap76(s)
    local out = []
    for i = 1, len(s), 76 do out[] = string.sub(s, i, i + 75) end
    return string.join(out, "\r\n")
end

local function part(ctype, content)
    return `Content-Type: ${ctype}\r\nContent-Transfer-Encoding: base64\r\n\r\n` .. wrap76(encoding.base64_encode(content))
end

local function multipart(kind, parts)
    local boundary = "sea-" .. string.replace(os.uuid(), "-", "")
    local lines = [`Content-Type: multipart/${kind}; boundary="${boundary}"\r\n`]
    for _, p in parts do
        lines[] = "--" .. boundary
        lines[] = p
    end
    lines[] = "--" .. boundary .. "--"
    return string.join(lines, "\r\n")
end

-- smtp.message(mail) → the message's bytes (RFC 5322 + MIME)
-- mail: from, to, cc, reply_to, subject, text, html, attachments
-- [{filename, content, type [, cid]}], headers {name = value}, id (the Message-ID).
-- An attachment with a cid is an image inline in the HTML (<img src="cid:...">):
-- with the HTML in a multipart/related; the others go as files (multipart/mixed)
-- bcc is left out of the headers on purpose
function M.message(mail)
    local lines = []
    lines[] = "From: " .. encode_address(mail.from)
    lines[] = "To: " .. string.join(list.map(list_of(mail.to), encode_address), ", ")
    local cc = list_of(mail.cc)
    if len(cc) > 0 then lines[] = "Cc: " .. string.join(list.map(cc, encode_address), ", ") end
    if mail.reply_to ~= nil then lines[] = "Reply-To: " .. encode_address(mail.reply_to) end
    lines[] = "Subject: " .. encode_header(mail.subject or "")
    lines[] = "Date: " .. time.now():format("Mon, 02 Jan 2006 15:04:05 -0700")
    lines[] = "Message-ID: " .. (mail.id or ("<" .. os.uuid() .. "@sea>"))
    for k, v in mail.headers or {} do lines[] = `${k}: ${encode_header(tostring(v))}` end
    lines[] = "MIME-Version: 1.0"
    local body = nil
    local text = part("text/plain; charset=utf-8", mail.text or "")
    if mail.html ~= nil then
        body = multipart("alternative", [text, part("text/html; charset=utf-8", mail.html)])
    else
        body = text
    end
    local inline = list.filter(mail.attachments or [], function(a) return a.cid ~= nil end)
    local files = list.filter(mail.attachments or [], function(a) return a.cid == nil end)
    if mail.html ~= nil and len(inline) > 0 then
        local parts = [body]
        for _, a in inline do
            local name = encode_header(a.filename or "image")
            parts[] = `Content-Type: ${a.type or "application/octet-stream"}; name="${name}"\r\n` ..
                `Content-Disposition: inline; filename="${name}"\r\n` .. `Content-ID: <${a.cid}>\r\n` ..
                "Content-Transfer-Encoding: base64\r\n\r\n" .. wrap76(encoding.base64_encode(a.content or ""))
        end
        body = multipart("related", parts)
    elseif len(inline) > 0 then
        -- no HTML to show them in: files
        files = list.concat(inline, files)
    end
    if len(files) > 0 then
        local parts = [body]
        for _, a in files do
            local name = encode_header(a.filename or "file")
            parts[] = `Content-Type: ${a.type or "application/octet-stream"}; name="${name}"\r\n` ..
                `Content-Disposition: attachment; filename="${name}"\r\n` ..
                "Content-Transfer-Encoding: base64\r\n\r\n" .. wrap76(encoding.base64_encode(a.content or ""))
        end
        body = multipart("mixed", parts)
    end
    lines[] = body
    return string.join(lines, "\r\n")
end

-- ---- the connection ----

local Client = {}

function Client.write(c, data)
    if c.tls ~= nil then return ssl.send(c.tls, data, c.timeout) end
    return net.write(c.fd, data, c.timeout)
end

function Client.line(c)
    while not string.contains(c.buf, "\n") do
        local chunk = nil
        if c.tls ~= nil then chunk = ssl.recv(c.tls, 65536, c.timeout) else chunk = net.read(c.fd, 65536, c.timeout) end
        if is_error(chunk) then return chunk end
        if chunk == "" then return error("smtp: the server closed the connection") end
        c.buf ..= chunk
    end
    local i = string.find(c.buf, "\n")
    local line = string.sub(c.buf, 1, i - 1)
    c.buf = string.sub(c.buf, i + 1)
    return string.trim(line)
end

-- one reply (all its lines) → {code, lines} | error
function Client.reply(c)
    local lines = []
    while true do
        local l = c:line()?
        lines[] = string.sub(l, 5)
        if len(l) < 4 or string.sub(l, 4, 4) ~= "-" then
            local out = {}
            out.code = tonumber(string.sub(l, 1, 3)) or 0
            out.lines = lines
            return out
        end
    end
end

-- a command and the reply it must get (want: its first digit, a string);
-- show: what an error names instead of the command (a password)
function Client.cmd(c, text, want, show)
    if text ~= nil then c:write(text .. "\r\n")? end
    local r = c:reply()?
    if string.sub(tostring(r.code), 1, 1) ~= want then
        return error(`smtp: ${show or text or "greeting"} → ${r.code} ${string.join(r.lines, " ")}`)
    end
    return r
end

local function extensions(c, r)
    c.ext = {}
    for i, l in r.lines do
        if i > 0 then
            local words = string.split(string.upper(l), " ")
            c.ext[words[0]] = l
        end
    end
end

-- smtp.dial(url [, opts]) → client | error: connected, TLS on, logged in.
-- opts: timeout (ms, per operation), helo (default "localhost"), and the
-- ssl.connect options (verify, ca, ...)
function M.dial(url, opts)
    opts = opts or {}
    local u = M.parse_url(url)?
    local c = {}
    c.timeout = opts.timeout or M.TIMEOUT
    c.buf = ""
    c.host = u.host
    for k, f in Client do c[k] = f end
    local tls_opts = {}
    for k, v in opts do tls_opts[k] = v end
    tls_opts.timeout = c.timeout
    if u.secure then
        c.tls = ssl.dial(u.host, u.port, tls_opts)?
    else
        c.fd = net.connect(u.host, u.port, c.timeout)?
    end
    local ok = (function()
        local helo = "EHLO " .. (opts.helo or "localhost")
        c:cmd(nil, "2")?
        extensions(c, c:cmd(helo, "2")?)
        if not u.secure and not u.plain then
            if c.ext.STARTTLS == nil then
                return error("smtp: the server does not offer STARTTLS (use smtps:// or ?tls=none)")
            end
            c:cmd("STARTTLS", "2")?
            c.tls = ssl.handshake_client(c.fd, u.host, tls_opts)?
            c.buf = ""
            extensions(c, c:cmd(helo, "2")?)
        end
        if u.user ~= nil then
            local auth = string.upper(c.ext.AUTH or "")
            if string.contains(auth, "PLAIN") or not string.contains(auth, "LOGIN") then
                local token = encoding.base64_encode("\0" .. u.user .. "\0" .. (u.pass or ""))
                c:cmd("AUTH PLAIN " .. token, "2", "AUTH PLAIN")?
            else
                c:cmd("AUTH LOGIN", "3")?
                c:cmd(encoding.base64_encode(u.user), "3", "AUTH LOGIN (user)")?
                c:cmd(encoding.base64_encode(u.pass or ""), "2", "AUTH LOGIN (password)")?
            end
        end
        return true
    end)()
    if is_error(ok) then
        c:close()
        return ok
    end
    return c
end

-- client:send(mail) → {id, accepted, rejected} | error: one message; the
-- connection stays open for the next. Every recipient (to, cc, bcc) gets it;
-- refused ones go in rejected, and only all refused is an error.
function Client.send(c, mail)
    local rcpt = list.concat(list_of(mail.to), list_of(mail.cc), list_of(mail.bcc))
    if mail.from == nil or len(rcpt) == 0 then return error("smtp: from and to are needed") end
    local m = {}
    for k, v in mail do m[k] = v end
    m.id = mail.id or ("<" .. os.uuid() .. "@" .. c.host .. ">")
    c:cmd(`MAIL FROM:<${M.address(mail.from)}>`, "2")?
    local accepted = []
    local rejected = []
    for _, to in rcpt do
        c:write(`RCPT TO:<${M.address(to)}>\r\n`)?
        local r = c:reply()?
        if r.code >= 200 and r.code < 300 then
            accepted[] = M.address(to)
        else
            rejected[] = {address = M.address(to), error = `${r.code} ${string.join(r.lines, " ")}`}
        end
    end
    if len(accepted) == 0 then
        local _ = c:cmd("RSET", "2")
        return error(`smtp: every recipient was refused: ${rejected[0].error}`)
    end
    c:cmd("DATA", "3")?
    -- dot-stuffing: a line that starts with "." gets another
    local body = re.gsub("(?m)^\\.", M.message(m), "..")
    c:write(body .. "\r\n.\r\n")?
    c:cmd(nil, "2", "the message")?
    local out = {}
    out.id = m.id
    out.accepted = accepted
    out.rejected = rejected
    return out
end

-- client:close(): QUIT, and the connection closed
function Client.close(c)
    if c.closed then return end
    c.closed = true
    local _ = c:write("QUIT\r\n")
    if c.tls ~= nil then ssl.close(c.tls) elseif c.fd ~= nil then net.close(c.fd) end
end

-- smtp.send(url, mail [, opts]) → {id, accepted, rejected} | error: dial,
-- send one message, close
function M.send(url, mail, opts)
    local c = M.dial(url, opts)?
    defer c:close()
    return c:send(mail)
end

return M
