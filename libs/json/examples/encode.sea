-- encode.sea — json.encode examples
-- Usage: bin/sea libs/json/examples/encode.sea

local json = require("../json")

-- primitives
print(json.encode(nil))           -- null
print(json.encode(true))          -- true
print(json.encode(42))            -- 42
print(json.encode(3.14))          -- 3.14
print(json.encode("hello world")) -- "hello world"

-- string escaping
print(json.encode("line1\nline2"))  -- "line1\nline2"
print(json.encode('say "hi"'))      -- "say \"hi\""

-- array (table with integer keys 0..n-1)
print(json.encode({1, 2, 3}))                    -- [1,2,3]
print(json.encode({"a", "b", "c"}))              -- ["a","b","c"]
print(json.encode({true, false, nil, 42}))        -- [true,false,null,42]

-- object (table with string keys; key order follows the table unless sort_keys)
print(json.encode({ name = "sea", version = 1 }, { sort_keys = true }))  -- {"name":"sea","version":1}

-- nested
local data = {
    lang  = "sea",
    tags  = {"fast", "concurrent", "simple"},
    meta  = { lines = 500, stable = true },
}
print(json.encode(data, { sort_keys = true }))

-- pretty-printed
print(json.encode(data, { indent = 2, sort_keys = true }))

-- non-ASCII as \uXXXX
print(json.encode("café ☕", { ascii = true }))   -- "caf\u00e9 \u2615"

-- floats keep their type: 3.0 stays 3.0, 0.1 stays 0.1
print(json.encode(3.0), json.encode(0.1))       -- 3.0  0.1

-- methods are left out of objects; a cycle is an error
local counter = { n = 1, inc = function() end }
print(json.encode(counter))                     -- {"n":1}
local loop = {}
loop.self = loop
print(json.encode(loop).message)                -- json.encode: cycle detected ...
