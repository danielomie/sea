-- jpeg — JPEG decoding into libs/image's grayscale images, in pure Sea.
--
--   jpeg.decode(bytes [, opts]) → {width, height, data} | error
--     opts.scale: 1 (default), 2, 4 or 8: the image comes out that many
--       times smaller, decoded straight at that size (a 4000×3000 photo at
--       scale 4 is 1000×750, about ten times faster than in full)
--     opts.max_side: pick the smallest scale whose longest side fits
--     opts.orient: false ignores the EXIF orientation (default: applied, as
--       a phone's photo is often stored sideways with a tag saying so)
--
-- Baseline and extended sequential JPEG (SOF0/SOF1, Huffman, 8-bit) and
-- progressive JPEG (SOF2); any chroma subsampling; restart intervals. Only
-- the luminance is decoded (the images are grayscale): the color
-- components' coefficients are read and dropped. Arithmetic coding,
-- lossless and 12-bit JPEG are refused.

local M = {}

local ZIGZAG = [
    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7,
    14, 21, 28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60,
    61, 54, 47, 55, 62, 63,
]

-- the range limit of a sample (128 added): CLAMP[p & 1023] is p held to
-- 0..255 (an overshoot up to 639 is 255, -384..-1 are 0: libjpeg's range_limit)
local CLAMP = int_array(1024)
for i = 0, 1023 do
    if i < 256 then
        CLAMP[] = i
    elseif i < 640 then
        CLAMP[] = 255
    else
        CLAMP[] = 0
    end
end

local function zeros(n)
    local a = int_array(n)
    if n > 0 then a[n - 1] = 0 end -- (writing past the end fills with zeros)
    return a
end

local function u16(s, i)
    return string.byte(s, i) * 256 + string.byte(s, i + 1)
end

-- ---- Huffman tables -------------------------------------------------------

-- a table from its 16 counts and symbols: a 9-bit lookup (fast[code] =
-- length * 256 + symbol, 0 when longer) and, for longer codes, maxcode /
-- valptr / mincode per length (the canonical decoding of the JPEG spec).
-- For an AC table, fastac decodes a whole coefficient when its code and
-- magnitude bits fit in 9: value * 256 + run * 16 + bits used (0 when not)
local function huffman(counts, symbols)
    local h = {}
    h.symbols = symbols
    h.fast = zeros(512)
    h.maxcode = []
    h.valptr = []
    h.mincode = []
    local code = 0
    local k = 0
    for l = 1, 16 do
        local n = counts[l - 1]
        h.valptr[] = k
        h.mincode[] = code
        if n > 0 then
            for _ = 1, n do
                if l <= 9 then
                    local shift = 9 - l
                    local base = code << shift
                    for f = 0, (1 << shift) - 1 do h.fast[base + f] = l * 256 + symbols[k] end
                end
                code += 1
                k += 1
            end
            h.maxcode[] = code - 1
        else
            h.maxcode[] = -1
        end
        code = code << 1
    end
    h.fastac = zeros(512)
    for look = 0, 511 do
        local f = h.fast[look]
        local l = f >> 8
        local size = f & 15
        if f ~= 0 and size > 0 and l + size <= 9 then
            local v = (look >> (9 - l - size)) & ((1 << size) - 1)
            if v < (1 << (size - 1)) then v = v - (1 << size) + 1 end
            h.fastac[look] = v * 256 + ((f >> 4) & 15) * 16 + l + size
        end
    end
    return h
end

-- ---- the entropy-coded data -------------------------------------------------

-- a bit reader over the scan data from byte pos (1-based): byte stuffing
-- (FF 00) removed; a marker stops the bits (zeros are fed past it)
local function reader(s, pos)
    local r = {}
    r.s = s
    r.pos = pos
    r.buf = 0
    r.cnt = 0
    r.marker = nil
    return r
end

-- (at least 33 bits in buf afterwards: a symbol and its magnitude bits)
local function fill(r)
    local s = r.s
    local n = len(s)
    local pos = r.pos
    local buf = r.buf
    local cnt = r.cnt
    while cnt <= 32 do
        local b = 0
        if r.marker == nil and pos <= n then
            b = string.byte(s, pos)
            if b == 0xFF then
                local nxt = string.byte(s, pos + 1) or 0
                if nxt == 0 then
                    pos += 2
                elseif nxt == 0xFF then
                    pos += 1 -- fill bytes before a marker
                    continue
                else
                    r.marker = nxt
                    b = 0
                end
            else
                pos += 1
            end
        end
        buf = ((buf & 0xFFFFFFFF) << 8) | b
        cnt += 8
    end
    r.pos = pos
    r.buf = buf
    r.cnt = cnt
end

local function bits(r, n)
    if n == 0 then return 0 end
    if r.cnt < n then fill(r) end
    r.cnt -= n
    return (r.buf >> r.cnt) & ((1 << n) - 1)
end

local function bit(r)
    if r.cnt < 1 then fill(r) end
    r.cnt -= 1
    return (r.buf >> r.cnt) & 1
end

local function decode_symbol(r, h)
    if r.cnt < 16 then fill(r) end
    local look = (r.buf >> (r.cnt - 9)) & 511
    local f = h.fast[look]
    if f ~= 0 then
        r.cnt -= f >> 8
        return f & 255
    end
    -- longer than 9 bits: one bit at a time
    local code = bits(r, 9)
    for l = 10, 16 do
        code = (code << 1) | bit(r)
        if code <= h.maxcode[l - 1] then
            return h.symbols[h.valptr[l - 1] + code - h.mincode[l - 1]]
        end
    end
    return error("jpeg: bad Huffman code")
end

-- the value of an n-bit magnitude (the JPEG "extend")
local function extend(v, n)
    if n == 0 then return 0 end
    if v < (1 << (n - 1)) then return v - (1 << n) + 1 end
    return v
end

-- past a restart marker: the bits start over at the next byte
local function restart(r)
    if r.marker ~= nil and r.marker >= 0xD0 and r.marker <= 0xD7 then
        r.pos += 2
    else
        -- the marker was not seen yet: find it
        while r.pos < len(r.s) do
            if string.byte(r.s, r.pos) == 0xFF then
                local m = string.byte(r.s, r.pos + 1)
                if m >= 0xD0 and m <= 0xD7 then
                    r.pos += 2
                    break
                end
            end
            r.pos += 1
        end
    end
    r.buf = 0
    r.cnt = 0
    r.marker = nil
end

-- ---- the inverse DCT -----------------------------------------------------------
--
-- coef: a block's 64 coefficients (natural order, dequantized); the n × n
-- pixels go to plane (pw wide) at (x0, y0), the whole block inside it.
-- n = 8 is libjpeg's accurate integer IDCT (jidctint.c: 13-bit constants,
-- 2 more bits between the passes); n = 4 and 2 evaluate the low
-- frequencies on a coarser grid (the block shrunk by 8/n, as libjpeg's
-- scaled decoding), with C(u) · cos((2x + 1)uπ / 2n) / 2 per pass.

local function idct8(c, ws, plane, pw, x0, y0)
    -- columns into ws, 2 bits up (a column of zeros past the DC is the DC)
    for col = 0, 7 do
        if c[col + 8] == 0 and c[col + 16] == 0 and c[col + 24] == 0 and c[col + 32] == 0 and c[col + 40] == 0 and
            c[col + 48] == 0 and c[col + 56] == 0 then
            local dc = c[col] << 2
            ws[col] = dc
            ws[col + 8] = dc
            ws[col + 16] = dc
            ws[col + 24] = dc
            ws[col + 32] = dc
            ws[col + 40] = dc
            ws[col + 48] = dc
            ws[col + 56] = dc
            continue
        end
        local z2 = c[col + 16]
        local z3 = c[col + 48]
        local z1 = (z2 + z3) * 4433
        local t2 = z1 - z3 * 15137
        local t3 = z1 + z2 * 6270
        z2 = c[col]
        z3 = c[col + 32]
        local t0 = (z2 + z3) << 13
        local t1 = (z2 - z3) << 13
        local t10 = t0 + t3 + 1024
        local t13 = t0 - t3 + 1024
        local t11 = t1 + t2 + 1024
        local t12 = t1 - t2 + 1024
        t0 = c[col + 56]
        t1 = c[col + 40]
        t2 = c[col + 24]
        t3 = c[col + 8]
        z1 = t0 + t3
        z2 = t1 + t2
        z3 = t0 + t2
        local z4 = t1 + t3
        local z5 = (z3 + z4) * 9633
        z1 = z1 * -7373
        z2 = z2 * -20995
        z3 = z3 * -16069 + z5
        z4 = z4 * -3196 + z5
        t0 = t0 * 2446 + z1 + z3
        t1 = t1 * 16819 + z2 + z4
        t2 = t2 * 25172 + z2 + z3
        t3 = t3 * 12299 + z1 + z4
        ws[col] = (t10 + t3) >> 11
        ws[col + 56] = (t10 - t3) >> 11
        ws[col + 8] = (t11 + t2) >> 11
        ws[col + 48] = (t11 - t2) >> 11
        ws[col + 16] = (t12 + t1) >> 11
        ws[col + 40] = (t12 - t1) >> 11
        ws[col + 24] = (t13 + t0) >> 11
        ws[col + 32] = (t13 - t0) >> 11
    end
    -- rows into pixels: 18 bits down, 128 added (in the rounding constant)
    for y = 0, 7 do
        local r = y * 8
        local o = (y0 + y) * pw + x0
        if ws[r + 1] == 0 and ws[r + 2] == 0 and ws[r + 3] == 0 and ws[r + 4] == 0 and ws[r + 5] == 0 and
            ws[r + 6] == 0 and ws[r + 7] == 0 then
            local v = CLAMP[((ws[r] + 4112) >> 5) & 1023]
            for x = o, o + 7 do plane[x] = v end
            continue
        end
        local z2 = ws[r + 2]
        local z3 = ws[r + 6]
        local z1 = (z2 + z3) * 4433
        local t2 = z1 - z3 * 15137
        local t3 = z1 + z2 * 6270
        z2 = ws[r]
        z3 = ws[r + 4]
        local t0 = (z2 + z3) << 13
        local t1 = (z2 - z3) << 13
        local t10 = t0 + t3 + 33685504
        local t13 = t0 - t3 + 33685504
        local t11 = t1 + t2 + 33685504
        local t12 = t1 - t2 + 33685504
        t0 = ws[r + 7]
        t1 = ws[r + 5]
        t2 = ws[r + 3]
        t3 = ws[r + 1]
        z1 = t0 + t3
        z2 = t1 + t2
        z3 = t0 + t2
        local z4 = t1 + t3
        local z5 = (z3 + z4) * 9633
        z1 = z1 * -7373
        z2 = z2 * -20995
        z3 = z3 * -16069 + z5
        z4 = z4 * -3196 + z5
        t0 = t0 * 2446 + z1 + z3
        t1 = t1 * 16819 + z2 + z4
        t2 = t2 * 25172 + z2 + z3
        t3 = t3 * 12299 + z1 + z4
        plane[o] = CLAMP[((t10 + t3) >> 18) & 1023]
        plane[o + 7] = CLAMP[((t10 - t3) >> 18) & 1023]
        plane[o + 1] = CLAMP[((t11 + t2) >> 18) & 1023]
        plane[o + 6] = CLAMP[((t11 - t2) >> 18) & 1023]
        plane[o + 2] = CLAMP[((t12 + t1) >> 18) & 1023]
        plane[o + 5] = CLAMP[((t12 - t1) >> 18) & 1023]
        plane[o + 3] = CLAMP[((t13 + t0) >> 18) & 1023]
        plane[o + 4] = CLAMP[((t13 - t0) >> 18) & 1023]
    end
end

-- 4 × 4 from the coefficients u, v < 4: per pass, with K = 1/(2√2),
-- C1 = cos(π/8)/2, C3 = cos(3π/8)/2 (13-bit integers: 2896, 3784, 1567),
-- e = K·(a ± c), o0 = C1·b + C3·d, o1 = C3·b − C1·d
local function idct4(c, ws, plane, pw, x0, y0)
    for v = 0, 3 do
        local r = v * 8
        local a = c[r]
        local b = c[r + 1]
        local cc = c[r + 2]
        local d = c[r + 3]
        local w = v * 4
        if b == 0 and cc == 0 and d == 0 then
            local e = (a * 2896 + 1024) >> 11
            ws[w] = e
            ws[w + 1] = e
            ws[w + 2] = e
            ws[w + 3] = e
            continue
        end
        local e0 = (a + cc) * 2896 + 1024
        local e1 = (a - cc) * 2896 + 1024
        local o0 = b * 3784 + d * 1567
        local o1 = b * 1567 - d * 3784
        ws[w] = (e0 + o0) >> 11
        ws[w + 3] = (e0 - o0) >> 11
        ws[w + 1] = (e1 + o1) >> 11
        ws[w + 2] = (e1 - o1) >> 11
    end
    -- 128 added and 15 bits down: (128 << 15) + (1 << 14)
    for x = 0, 3 do
        local a = ws[x]
        local b = ws[x + 4]
        local cc = ws[x + 8]
        local d = ws[x + 12]
        local e0 = (a + cc) * 2896 + 4210688
        local e1 = (a - cc) * 2896 + 4210688
        local o0 = b * 3784 + d * 1567
        local o1 = b * 1567 - d * 3784
        local o = y0 * pw + x0 + x
        plane[o] = CLAMP[((e0 + o0) >> 15) & 1023]
        plane[o + pw] = CLAMP[((e1 + o1) >> 15) & 1023]
        plane[o + 2 * pw] = CLAMP[((e1 - o1) >> 15) & 1023]
        plane[o + 3 * pw] = CLAMP[((e0 - o0) >> 15) & 1023]
    end
end

-- 2 × 2: each pixel is (c00 ± c01 ± c10 ± c11) / 8
local function idct2(c, plane, pw, x0, y0)
    local a = c[0] + 1028
    local b = c[1]
    local cc = c[8]
    local d = c[9]
    local o = y0 * pw + x0
    plane[o] = CLAMP[((a + b + cc + d) >> 3) & 1023]
    plane[o + 1] = CLAMP[((a - b + cc - d) >> 3) & 1023]
    plane[o + pw] = CLAMP[((a + b - cc - d) >> 3) & 1023]
    plane[o + pw + 1] = CLAMP[((a - b - cc + d) >> 3) & 1023]
end

-- the block (dc_only: no AC coefficient) as n × n pixels at block (bx, by)
-- of the plane (pw × ph); a block across the plane's edge is drawn into
-- edge (n × n) first and the part inside copied
local function put_block(coef, dc_only, plane, pw, ph, bx, by, n, ws, edge)
    local x0 = bx * n
    local y0 = by * n
    local dst = plane
    local dw = pw
    local inside = x0 + n <= pw and y0 + n <= ph
    if not inside then
        dst = edge
        dw = n
        x0 = 0
        y0 = 0
    end
    if dc_only or n == 1 then
        local v = CLAMP[((coef[0] + 1028) >> 3) & 1023]
        for y = y0, y0 + n - 1 do
            local o = y * dw + x0
            for x = o, o + n - 1 do dst[x] = v end
        end
    elseif n == 8 then
        idct8(coef, ws, dst, dw, x0, y0)
    elseif n == 4 then
        idct4(coef, ws, dst, dw, x0, y0)
    else
        idct2(coef, dst, dw, x0, y0)
    end
    if not inside then
        x0 = bx * n
        y0 = by * n
        for y = 0, n - 1 do
            if y0 + y >= ph then break end
            for x = 0, n - 1 do
                if x0 + x < pw then plane[(y0 + y) * pw + x0 + x] = edge[y * n + x] end
            end
        end
    end
end

-- ---- the frame ---------------------------------------------------------------

-- the EXIF orientation of an APP1 segment (1 when none)
local function exif_orientation(s, start, length)
    if string.sub(s, start, start + 5) ~= "Exif\0\0" then return 1 end
    local t = start + 6 -- the TIFF header
    local le = string.sub(s, t, t + 1) == "II"
    local function r16(i)
        local a, b = string.byte(s, i), string.byte(s, i + 1)
        if a == nil or b == nil then return 0 end
        return le and (b * 256 + a) or (a * 256 + b)
    end
    local function r32(i)
        return le and (r16(i + 2) * 65536 + r16(i)) or (r16(i) * 65536 + r16(i + 2))
    end
    local ifd = t + r32(t + 4)
    local n = r16(ifd)
    for k = 0, n - 1 do
        local e = ifd + 2 + k * 12
        if e + 12 > start + length then break end
        if r16(e) == 0x0112 then return r16(e + 8) end
    end
    return 1
end

-- an image turned per an EXIF orientation (only the turns: 3, 6, 8; the
-- mirrored ones are rare and kept as they are)
local function orient(img, o)
    if o ~= 3 and o ~= 6 and o ~= 8 then return img end
    local w, h = img.width, img.height
    local src = img.data
    local out = zeros(w * h)
    local nw, nh = w, h
    if o == 6 or o == 8 then
        nw, nh = h, w
    end
    for y = 0, h - 1 do
        for x = 0, w - 1 do
            local v = src[y * w + x]
            if o == 3 then
                out[(h - 1 - y) * w + (w - 1 - x)] = v
            elseif o == 6 then -- 90° clockwise
                out[x * nw + (nw - 1 - y)] = v
            else
                -- 90° counter-clockwise
                out[(nh - 1 - x) * nw + y] = v
            end
        end
    end
    local r = {}
    r.width = nw
    r.height = nh
    r.data = out
    return r
end

-- jpeg.decode(bytes [, opts]) → {width, height, data} | error
function M.decode(s, opts)
    opts = opts or {}
    if type(s) ~= "string" or string.sub(s, 1, 2) ~= "\xff\xd8" then return error("jpeg: not a JPEG file") end
    local qt = {}
    local dc_tables = {}
    local ac_tables = {}
    local frame = nil
    local restart_interval = 0
    local orientation = 1
    local pos = 3
    local progressive = false
    local done = false
    while not done and pos < len(s) do
        if string.byte(s, pos) ~= 0xFF then
            pos += 1 -- garbage between segments
            continue
        end
        local m = string.byte(s, pos + 1)
        if m == 0xFF then
            pos += 1
            continue
        end
        if m == 0xD8 or (m >= 0xD0 and m <= 0xD7) or m == 0x01 then
            pos += 2
            continue
        end
        if m == 0xD9 then break end
        do
            local length = u16(s, pos + 2)
            local seg = pos + 4           -- the segment's data
            local stop = pos + 2 + length -- the byte after it
            if m == 0xDB then             -- DQT
                local p = seg
                while p < stop do
                    local pq = string.byte(s, p) >> 4
                    local id = string.byte(s, p) & 15
                    p += 1
                    local q = zeros(64)
                    for k = 0, 63 do
                        local v = 0
                        if pq == 0 then
                            v = string.byte(s, p)
                            p += 1
                        else
                            v = u16(s, p)
                            p += 2
                        end
                        q[ZIGZAG[k]] = v
                    end
                    qt[id] = q
                end
            elseif m == 0xC4 then -- DHT
                local p = seg
                while p < stop do
                    local tc = string.byte(s, p) >> 4
                    local id = string.byte(s, p) & 15
                    local counts = []
                    local total = 0
                    for l = 0, 15 do
                        counts[] = string.byte(s, p + 1 + l)
                        total += counts[l]
                    end
                    local symbols = []
                    for k = 0, total - 1 do symbols[] = string.byte(s, p + 17 + k) end
                    p += 17 + total
                    if tc == 0 then dc_tables[id] = huffman(counts, symbols) else ac_tables[id] = huffman(counts, symbols) end
                end
            elseif m == 0xC0 or m == 0xC1 or m == 0xC2 then
                if string.byte(s, seg) ~= 8 then return error("jpeg: only 8-bit samples are read") end
                progressive = m == 0xC2
                frame = {}
                frame.height = u16(s, seg + 1)
                frame.width = u16(s, seg + 3)
                local nc = string.byte(s, seg + 5)
                frame.comps = []
                frame.hmax = 1
                frame.vmax = 1
                for c = 0, nc - 1 do
                    local p = seg + 6 + c * 3
                    local comp = {}
                    comp.id = string.byte(s, p)
                    comp.h = string.byte(s, p + 1) >> 4
                    comp.v = string.byte(s, p + 1) & 15
                    comp.tq = string.byte(s, p + 2)
                    frame.comps[] = comp
                    if comp.h > frame.hmax then frame.hmax = comp.h end
                    if comp.v > frame.vmax then frame.vmax = comp.v end
                end
                if frame.width == 0 or frame.height == 0 then return error("jpeg: the image has no size") end
                frame.mcux = (frame.width + 8 * frame.hmax - 1) // (8 * frame.hmax)
                frame.mcuy = (frame.height + 8 * frame.vmax - 1) // (8 * frame.vmax)
                for _, comp in frame.comps do
                    comp.bw = frame.mcux * comp.h -- blocks per line, padded to whole MCUs
                    comp.bh = frame.mcuy * comp.v
                    comp.pred = 0
                    comp.eobrun = 0
                end
                -- the luminance is the first component
                local y = frame.comps[0]
                y.keep = true
                if progressive then
                    -- every coefficient of the luminance, kept across scans
                    y.coefs = zeros(y.bw * y.bh * 64)
                end
                -- the output size: scale 1, 2, 4 or 8
                local scale = opts.scale or 1
                if opts.max_side ~= nil then
                    scale = 1
                    while scale < 8 and math.max(frame.width, frame.height) // scale > opts.max_side do scale *= 2 end
                end
                if scale ~= 1 and scale ~= 2 and scale ~= 4 and scale ~= 8 then
                    return error("jpeg: scale is 1, 2, 4 or 8")
                end
                frame.n = 8 // scale
                -- the luminance plane, n pixels a block
                y.pw = (frame.width * y.h // frame.hmax + scale - 1) // scale
                y.ph = (frame.height * y.v // frame.vmax + scale - 1) // scale
                -- (every pixel is drawn: the blocks cover the plane)
                y.plane = zeros(y.pw * y.ph)
                frame.scale = scale
            elseif m == 0xC3 or (m >= 0xC5 and m <= 0xCF and m ~= 0xC8 and m ~= 0xCC) then
                return error("jpeg: this kind of JPEG is not read (lossless, hierarchical or arithmetic coding)")
            elseif m == 0xDD then -- DRI
                restart_interval = u16(s, seg)
            elseif m == 0xE1 then -- APP1: Exif
                local o = exif_orientation(s, seg, length - 2)
                if o > 1 then orientation = o end
            elseif m == 0xDA then -- SOS
                if frame == nil then return error("jpeg: a scan before the frame") end
                local ns = string.byte(s, seg)
                local scomps = []
                for k = 0, ns - 1 do
                    local cid = string.byte(s, seg + 1 + k * 2)
                    local tables = string.byte(s, seg + 2 + k * 2)
                    local comp = nil
                    for _, c in frame.comps do
                        if c.id == cid then comp = c end
                    end
                    if comp == nil then return error("jpeg: a scan of an unknown component") end
                    comp.dc = dc_tables[tables >> 4]
                    comp.ac = ac_tables[tables & 15]
                    scomps[] = comp
                end
                local p = seg + 1 + ns * 2
                local ss = string.byte(s, p)
                local se = string.byte(s, p + 1)
                local ah = string.byte(s, p + 2) >> 4
                local al = string.byte(s, p + 2) & 15
                local r = reader(s, stop)
                local ok = nil
                if progressive then
                    ok = M._scan_progressive(r, frame, scomps, ss, se, ah, al, restart_interval)
                else
                    ok = M._scan_baseline(r, frame, scomps, qt, restart_interval)
                end
                if is_error(ok) then return ok end
                -- the next marker: where the bits stopped
                pos = r.pos
                while pos < len(s) and not (string.byte(s, pos) == 0xFF and string.byte(s, pos + 1) ~= 0 and
                    not (string.byte(s, pos + 1) >= 0xD0 and string.byte(s, pos + 1) <= 0xD7)) do
                    pos += 1
                end
                continue
            end
            pos = stop
        end
    end
    if frame == nil then return error("jpeg: no image in the file") end
    local y = frame.comps[0]
    if progressive then
        -- every scan read: the luminance's blocks out
        local q = qt[y.tq]
        if q == nil then return error("jpeg: a quantization table is missing") end
        local coef = zeros(64)
        local ws = zeros(64)
        local edge = zeros(64)
        local coefs = y.coefs
        local n = frame.n
        local bw = (y.pw * frame.scale + 7) // 8
        local bh = (y.ph * frame.scale + 7) // 8
        for by = 0, math.min(bh, y.bh) - 1 do
            for bx = 0, math.min(bw, y.bw) - 1 do
                local base = (by * y.bw + bx) * 64
                local ac = 0
                if n == 8 then
                    coef[0] = coefs[base] * q[0]
                    for k = 1, 63 do
                        local v = coefs[base + k]
                        coef[k] = v * q[k]
                        ac = ac | v
                    end
                else
                    -- (a reduced IDCT reads only the n × n low frequencies)
                    for k = 0, (n - 1) * 9 do
                        if k & 7 < n then
                            local v = coefs[base + k]
                            coef[k] = v * q[k]
                            if k > 0 then ac = ac | v end
                        end
                    end
                end
                put_block(coef, ac == 0, y.plane, y.pw, y.ph, bx, by, n, ws, edge)
            end
        end
    end
    local img = {}
    img.width = y.pw
    img.height = y.ph
    img.data = y.plane
    -- (a luminance sampled below the others: stretched to the frame's size)
    local fw = (frame.width + frame.scale - 1) // frame.scale
    local fh = (frame.height + frame.scale - 1) // frame.scale
    if y.pw ~= fw or y.ph ~= fh then
        local out = int_array(fw * fh)
        for yy = 0, fh - 1 do
            local sy = yy * y.ph // fh
            for xx = 0, fw - 1 do out[] = y.plane[sy * y.pw + xx * y.pw // fw] end
        end
        img.width = fw
        img.height = fh
        img.data = out
    end
    if opts.orient ~= false then img = orient(img, orientation) end
    return img
end

-- ---- sequential scans ---------------------------------------------------------

-- one block's coefficients into coef (natural order, dequantized by q),
-- over the zeros the previous block left; the highest zigzag position
-- written. The bit reader is inlined: fill leaves at least 33 bits, enough
-- for a code (16) and its magnitude (11), so one check per coefficient.
local function read_block(r, comp, coef, q)
    local buf = r.buf
    local cnt = r.cnt
    if cnt < 27 then
        fill(r)
        buf = r.buf
        cnt = r.cnt
    end
    -- the DC difference
    local h = comp.dc
    local t = 0
    local f = h.fast[(buf >> (cnt - 9)) & 511]
    if f ~= 0 then
        cnt -= f >> 8
        t = f & 255
    else
        r.cnt = cnt
        t = decode_symbol(r, h)?
        buf = r.buf
        cnt = r.cnt
    end
    if t > 0 then
        cnt -= t
        local d = (buf >> cnt) & ((1 << t) - 1)
        if d < (1 << (t - 1)) then d = d - (1 << t) + 1 end
        comp.pred += d
    end
    coef[0] = comp.pred * q[0]
    -- the AC coefficients
    h = comp.ac
    local fast = h.fast
    local fastac = h.fastac
    local k = 1
    local last = 0
    while k < 64 do
        if cnt < 27 then
            r.cnt = cnt
            fill(r)
            buf = r.buf
            cnt = r.cnt
        end
        local look = (buf >> (cnt - 9)) & 511
        local fa = fastac[look]
        if fa ~= 0 then
            -- code and magnitude in one lookup
            cnt -= fa & 15
            k += (fa >> 4) & 15
            if k > 63 then return error("jpeg: bad coefficient run") end
            local z = ZIGZAG[k]
            coef[z] = (fa >> 8) * q[z]
            last = k
            k += 1
            continue
        end
        local rs = 0
        f = fast[look]
        if f ~= 0 then
            cnt -= f >> 8
            rs = f & 255
        else
            r.cnt = cnt
            rs = decode_symbol(r, h)?
            buf = r.buf
            cnt = r.cnt
        end
        local size = rs & 15
        if size == 0 then
            if rs ~= 0xF0 then break end -- end of block
            k += 16
        else
            k += rs >> 4
            if k > 63 then return error("jpeg: bad coefficient run") end
            cnt -= size
            local v = (buf >> cnt) & ((1 << size) - 1)
            if v < (1 << (size - 1)) then v = v - (1 << size) + 1 end
            local z = ZIGZAG[k]
            coef[z] = v * q[z]
            last = k
            k += 1
        end
    end
    r.cnt = cnt
    return last
end

function M._scan_baseline(r, frame, scomps, qt, restart_interval)
    local coef = zeros(64)
    -- a dropped component's coefficients go to skip, undequantized
    local skip = zeros(64)
    local ones = int_array(64)
    for _ = 0, 63 do ones[] = 1 end
    local ws = zeros(64)
    local edge = zeros(64)
    for _, c in scomps do c.pred = 0 end
    local single = len(scomps) == 1
    local y = frame.comps[0]
    local q = qt[y.tq]
    if q == nil then return error("jpeg: a quantization table is missing") end
    -- the blocks of the luminance that reach the output (padding blocks are read, not drawn)
    local n = frame.n
    local plane = y.plane
    local pw = y.pw
    local ph = y.ph
    local bw_out = (pw + n - 1) // n
    local bh_out = (ph + n - 1) // n
    local units = 0
    -- the blocks of one MCU: component, its sampling and the block's
    -- offset (a single-component scan is not interleaved: an MCU is one
    -- of its blocks, with no padding to whole MCUs)
    local slot_c = []
    local slot_h = []
    local slot_v = []
    local slot_dx = []
    local slot_dy = []
    local mcux = frame.mcux
    local mcuy = frame.mcuy
    if single then
        local c = scomps[0]
        mcux = (frame.width * c.h // frame.hmax + 7) // 8
        mcuy = (frame.height * c.v // frame.vmax + 7) // 8
        slot_c[] = c
        slot_h[] = 1
        slot_v[] = 1
        slot_dx[] = 0
        slot_dy[] = 0
    else
        for _, c in scomps do
            for v = 0, c.v - 1 do
                for h = 0, c.h - 1 do
                    slot_c[] = c
                    slot_h[] = c.h
                    slot_v[] = c.v
                    slot_dx[] = h
                    slot_dy[] = v
                end
            end
        end
    end
    local nslots = len(slot_c)
    for my = 0, mcuy - 1 do
        for mx = 0, mcux - 1 do
            if restart_interval > 0 and units > 0 and units % restart_interval == 0 then
                restart(r)
                for _, c in scomps do c.pred = 0 end
            end
            for j = 0, nslots - 1 do
                local c = slot_c[j]
                local bx = mx * slot_h[j] + slot_dx[j]
                local by = my * slot_v[j] + slot_dy[j]
                if c.keep and bx < bw_out and by < bh_out then
                    local last = read_block(r, c, coef, q)?
                    local x0 = bx * n
                    local y0 = by * n
                    if last == 0 and x0 + n <= pw and y0 + n <= ph then
                        -- (only a DC, inside the plane: the commonest block)
                        local val = CLAMP[((coef[0] + 1028) >> 3) & 1023]
                        for o = y0 * pw + x0, (y0 + n - 1) * pw + x0, pw do
                            for x = o, o + n - 1 do plane[x] = val end
                        end
                    else
                        put_block(coef, last == 0, plane, pw, ph, bx, by, n, ws, edge)
                        for k = 1, last do coef[ZIGZAG[k]] = 0 end
                    end
                else
                    local _ = read_block(r, c, skip, ones)?
                end
            end
            units += 1
        end
    end
    return true
end

-- ---- progressive scans ---------------------------------------------------------

-- the coefficients of one block (zigzag positions ss..se) for a progressive
-- scan; coefs nil for a dropped component
local function prog_block(r, c, coefs, base, ss, se, ah, al)
    if ss == 0 then
        -- DC: first pass or refinement
        if ah == 0 then
            local t = decode_symbol(r, c.dc)?
            c.pred += extend(bits(r, t), t)
            if coefs ~= nil then coefs[base] = c.pred << al end
        else
            local b = bit(r)
            if coefs ~= nil and b == 1 then coefs[base] = coefs[base] | (1 << al) end
        end
        return true
    end
    -- the AC bands: coefs is never nil here (a dropped component keeps a
    -- shadow), and the bit reader is inlined as in read_block
    local buf = r.buf
    local cnt = r.cnt
    local h = c.ac
    local fast = h.fast
    local k = ss
    if ah == 0 then
        -- first pass
        if c.eobrun > 0 then
            c.eobrun -= 1
            return true
        end
        local fastac = h.fastac
        local scale = 1 << al
        while k <= se do
            if cnt < 27 then
                r.cnt = cnt
                fill(r)
                buf = r.buf
                cnt = r.cnt
            end
            local look = (buf >> (cnt - 9)) & 511
            local fa = fastac[look]
            if fa ~= 0 then
                cnt -= fa & 15
                k += (fa >> 4) & 15
                if k > 63 then return error("jpeg: bad coefficient run") end
                coefs[base + ZIGZAG[k]] = (fa >> 8) * scale
                k += 1
                continue
            end
            local rs = 0
            local f = fast[look]
            if f ~= 0 then
                cnt -= f >> 8
                rs = f & 255
            else
                r.cnt = cnt
                rs = decode_symbol(r, h)?
                buf = r.buf
                cnt = r.cnt
            end
            local run = rs >> 4
            local size = rs & 15
            if size == 0 then
                if run < 15 then
                    c.eobrun = (1 << run) - 1
                    if run > 0 then
                        if cnt < run then
                            r.cnt = cnt
                            fill(r)
                            buf = r.buf
                            cnt = r.cnt
                        end
                        cnt -= run
                        c.eobrun += (buf >> cnt) & ((1 << run) - 1)
                    end
                    break
                end
                k += 16
            else
                k += run
                if k > 63 then return error("jpeg: bad coefficient run") end
                cnt -= size
                local v = (buf >> cnt) & ((1 << size) - 1)
                if v < (1 << (size - 1)) then v = v - (1 << size) + 1 end
                coefs[base + ZIGZAG[k]] = v * scale
                k += 1
            end
        end
        r.cnt = cnt
        return true
    end
    -- refinement: one more bit for the coefficients already nonzero, and
    -- new ones of magnitude 1 << al (for a dropped component too: which
    -- coefficients are nonzero decides how the bits are read)
    local p1 = 1 << al
    local m1 = -1 << al
    if c.eobrun <= 0 then
        while k <= se do
            if cnt < 27 then
                r.cnt = cnt
                fill(r)
                buf = r.buf
                cnt = r.cnt
            end
            local rs = 0
            local f = fast[(buf >> (cnt - 9)) & 511]
            if f ~= 0 then
                cnt -= f >> 8
                rs = f & 255
            else
                r.cnt = cnt
                rs = decode_symbol(r, h)?
                buf = r.buf
                cnt = r.cnt
            end
            local run = rs >> 4
            local value = 0
            if rs & 15 == 0 then
                if run < 15 then
                    c.eobrun = 1 << run
                    if run > 0 then
                        if cnt < run then
                            r.cnt = cnt
                            fill(r)
                            buf = r.buf
                            cnt = r.cnt
                        end
                        cnt -= run
                        c.eobrun += (buf >> cnt) & ((1 << run) - 1)
                    end
                    break
                end
            else
                cnt -= 1
                value = (buf >> cnt) & 1 == 1 and p1 or m1
            end
            while k <= se do
                local i = base + ZIGZAG[k]
                local cur = coefs[i]
                if cur ~= 0 then
                    if cnt < 1 then
                        r.cnt = cnt
                        fill(r)
                        buf = r.buf
                        cnt = r.cnt
                    end
                    cnt -= 1
                    if (buf >> cnt) & 1 == 1 and (cur & p1) == 0 then
                        coefs[i] = cur >= 0 and cur + p1 or cur + m1
                    end
                elseif run == 0 then
                    if value ~= 0 then coefs[i] = value end
                    k += 1
                    break
                else
                    run -= 1
                end
                k += 1
            end
        end
    end
    if c.eobrun > 0 then
        -- the rest of the band in an end-of-band run: only refinements
        while k <= se do
            local i = base + ZIGZAG[k]
            local cur = coefs[i]
            if cur ~= 0 then
                if cnt < 1 then
                    r.cnt = cnt
                    fill(r)
                    buf = r.buf
                    cnt = r.cnt
                end
                cnt -= 1
                if (buf >> cnt) & 1 == 1 and (cur & p1) == 0 then
                    coefs[i] = cur >= 0 and cur + p1 or cur + m1
                end
            end
            k += 1
        end
        c.eobrun -= 1
    end
    r.cnt = cnt
    return true
end

function M._scan_progressive(r, frame, scomps, ss, se, ah, al, restart_interval)
    for _, c in scomps do
        c.pred = 0
        c.eobrun = 0
    end
    local units = 0
    local function coefs_of(c)
        if c.keep then return c.coefs end
        -- a dropped component needs its coefficients only to refine AC
        -- bands (the nonzero ones decide how the bits are read)
        if ss > 0 then
            if c.shadow == nil then
                c.shadow = zeros(c.bw * c.bh * 64)
            end
            return c.shadow
        end
        return nil
    end
    if len(scomps) == 1 then
        local c = scomps[0]
        local coefs = coefs_of(c)
        local w = (frame.width * c.h // frame.hmax + 7) // 8
        local h = (frame.height * c.v // frame.vmax + 7) // 8
        for by = 0, h - 1 do
            for bx = 0, w - 1 do
                if restart_interval > 0 and units > 0 and units % restart_interval == 0 then
                    restart(r)
                    c.pred = 0
                    c.eobrun = 0
                end
                local _ = prog_block(r, c, coefs, (by * c.bw + bx) * 64, ss, se, ah, al)?
                units += 1
            end
        end
        return true
    end
    -- interleaved: DC scans only
    local ccoefs = list.map(scomps, coefs_of)
    for my = 0, frame.mcuy - 1 do
        for mx = 0, frame.mcux - 1 do
            if restart_interval > 0 and units > 0 and units % restart_interval == 0 then
                restart(r)
                for _, c in scomps do
                    c.pred = 0
                    c.eobrun = 0
                end
            end
            for ci, c in scomps do
                local coefs = ccoefs[ci]
                for v = 0, c.v - 1 do
                    for h = 0, c.h - 1 do
                        local bx = mx * c.h + h
                        local by = my * c.v + v
                        local _ = prog_block(r, c, coefs, (by * c.bw + bx) * 64, ss, se, ah, al)?
                    end
                end
            end
            units += 1
        end
    end
    return true
end

return M
