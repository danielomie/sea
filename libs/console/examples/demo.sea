-- demo.sea — console library showcase
-- Usage: bin/sea libs/console/examples/demo.sea

local console = require("./libs/console/console")
local time    = require("time")

-- ---- Terminal size --------------------------------------------------------
local sz = console.size()
console.writeln("Terminal: " .. sz.width .. "x" .. sz.height, { color = "bright_black" })
console.writeln("")

-- ---- Colors ---------------------------------------------------------------
console.writeln("=== Colors ===", { bold = true, color = "bright_white" })

local colors = {"red","green","yellow","blue","magenta","cyan","white",
                "bright_red","bright_green","bright_yellow","bright_blue",
                "bright_magenta","bright_cyan","bright_white"}
for i = 0, len(colors) - 1 do
    console.write("  " .. string.pad_right(colors[i], 18), { color = colors[i] })
    if (i + 1) % 4 == 0 then console.writeln("") end
end
console.writeln("")

-- ---- Styles ---------------------------------------------------------------
console.writeln("=== Styles ===", { bold = true, color = "bright_white" })
console.writeln("  Normal text")
console.writeln("  Bold text",      { bold      = true })
console.writeln("  Dim text",       { dim       = true })
console.writeln("  Italic text",    { italic    = true })
console.writeln("  Underline text", { underline = true })
console.writeln("  Reverse text",   { reverse   = true })
console.writeln("  Red on white",   { color = "red", bg = "white" })
console.writeln("  True-color #3B82F6", { color = "#3B82F6" })
console.writeln("  RGB {r=255,g=165,b=0}", { color = {r=255, g=165, b=0} })
console.writeln("")

-- ---- Progress bar ---------------------------------------------------------
console.writeln("=== Progress bar ===", { bold = true, color = "bright_white" })

local total = 40
for i = 0, total do
    console.write("\r  ")
    console.progress(i, total, { width = 30, show_percent = true, show_count = true, color = "green" })
    time.sleep(time.Millisecond * 40)
end
console.writeln("")
console.writeln("")

-- Danger zone style
console.write("  ")
console.progress(80, 100, { width = 30, color = "yellow", show_percent = true })
console.writeln("  warning")
console.write("  ")
console.progress(97, 100, { width = 30, color = "red",    show_percent = true })
console.writeln("  critical")
console.writeln("")

-- ---- Shimmer effect -------------------------------------------------------
console.writeln("=== Shimmer ===", { bold = true, color = "bright_white" })
console.write("  ")
console.shimmer("Sea programming language — fast, concurrent, simple.")
console.writeln("")
console.write("  ")
console.shimmer("Loading modules...", { duration = 5.0, color = {r=100, g=180, b=255} })
console.writeln("  done")
console.writeln("")

-- ---- Cursor positioning ---------------------------------------------------
console.writeln("=== Cursor positioning ===", { bold = true, color = "bright_white" })
console.writeln("  Line A")
console.writeln("  Line B  (will be overwritten)")
console.writeln("  Line C")
console.up(2)
console.write("\r")
console.write("  Line B  ", { color = "yellow", bold = true })
console.writeln("(overwritten!)", { color = "yellow" })
console.down(1)
console.writeln("")

console.writeln("Done!", { bold = true, color = "bright_green" })
