-- examples/server.sea — flags estilo servidor com usage customizado
--
-- Run: bin/sea libs/flags/examples/server.sea -port 3000 -env production
-- Run: bin/sea libs/flags/examples/server.sea --help

local flags = require("../flags")

-- Usage customizado (como flag.Usage = func() no Go)
flags.set_usage(function()
    print("server — servidor de exemplo em Sea")
    print("")
    print("Uso: server [flags]")
    print("")
    print("Flags:")
    print("  -port int       porta de escuta (default 8080)")
    print("  -host string    endereço de bind (default \"0.0.0.0\")")
    print("  -env  string    ambiente: development|production (default \"development\")")
    print("  -workers int    número de workers (default 4)")
    print("  -timeout float  timeout em segundos (default 30.0)")
    print("  -tls            habilitar TLS (default false)")
end)

local port    = flags.int("port",     8080,          "porta de escuta")
local host    = flags.string("host",  "0.0.0.0",     "endereço de bind")
local env     = flags.string("env",   "development", "ambiente")
local workers = flags.int("workers",  4,             "número de workers")
local timeout = flags.number("timeout", 30.0,        "timeout em segundos")
local tls     = flags.bool("tls",     false,         "habilitar TLS")

flags.parse()

print("Configuração do servidor:")
print("  host     = " .. host.value)
print("  port     = " .. port.value)
print("  env      = " .. env.value)
print("  workers  = " .. workers.value)
print("  timeout  = " .. timeout.value .. "s")
print("  tls      = " .. tostring(tls.value))

if env.value ~= "development" and env.value ~= "production" then
    print("erro: -env deve ser 'development' ou 'production'")
    os.exit(1)
end

if port.value < 1 or port.value > 65535 then
    print("erro: -port deve estar entre 1 e 65535")
    os.exit(1)
end

print("")
print("Servidor pronto em " .. host.value .. ":" .. port.value)
