-- examples/basic.sea — uso básico da lib flags
--
-- Run: bin/sea libs/flags/examples/basic.sea -host api.example.com -port 9090 -verbose file1.txt file2.txt
-- Run: bin/sea libs/flags/examples/basic.sea --help

local flags = require("../flags")

local host    = flags.string("host",    "localhost", "endereço do servidor")
local port    = flags.int("port",       8080,        "porta do servidor")
local verbose = flags.bool("verbose",   false,       "habilitar saída detalhada")
local rate    = flags.number("rate",    1.0,         "taxa de requisições por segundo")
local output  = flags.string("output",  "stdout",    "arquivo de saída")

flags.parse()

print("host    = " .. host.value)
print("port    = " .. port.value)
print("verbose = " .. tostring(verbose.value))
print("rate    = " .. rate.value)
print("output  = " .. output.value)
print("")

-- flags explicitamente passadas
print("flags definidas:")
if flags.is_set("host")    then print("  -host foi passado") end
if flags.is_set("port")    then print("  -port foi passado") end
if flags.is_set("verbose") then print("  -verbose foi passado") end
print("")

-- argumentos posicionais
local rest = flags.args()
local narg = flags.narg()
print("argumentos posicionais (" .. narg .. "):")
if narg > 0 then
    for i = 0, narg - 1 do
        print("  [" .. i .. "] " .. rest[i])
    end
end
