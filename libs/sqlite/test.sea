-- libs/sqlite test: make -C libs/sqlite test
local sqlite = require("sqlite")
local json = require("json")   -- built into sea

local function show(v)
    if is_error(v) then return "error: " .. v.message end
    return json.encode(v, {sort_keys = true})
end

print("-- open, exec, query")
print(string.starts_with(sqlite.version(), "3."))
local db = sqlite.open()
print(db.path, db:exec("CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER, score REAL, photo BLOB)"))
print(db:exec("INSERT INTO people (name, age, score) VALUES (?, ?, ?)", "ana", 31, 9.5), db:last_insert_id())
print(db:exec("INSERT INTO people (name, age, score) VALUES (?, ?, ?)", {"bo", 25, 7}))
local p = {}
p.n = "cid"
p.a = 40
print(db:exec("INSERT INTO people (name, age) VALUES (:n, @a)", p), db:last_insert_id())
print(show(db:query("SELECT id, name, age, score FROM people ORDER BY id")))
print(show(db:row("SELECT name, age FROM people WHERE age > ? ORDER BY age", 30)))
print(show(db:row("SELECT name FROM people WHERE age > 100")), db:value("SELECT count(*) FROM people"), db:value("SELECT name FROM people WHERE id = 99"))
print(db:exec("UPDATE people SET age = age + 1"), db:exec("DELETE FROM people WHERE name = ?", "nobody"))
print(db:exec("CREATE TABLE a (x); CREATE TABLE b (y); INSERT INTO a VALUES (1), (2); INSERT INTO b VALUES (3)"))
print(show(db:query("SELECT 1 AS one; SELECT x FROM a ORDER BY x")))

print("-- types")
print(show(db:row("SELECT 140737488355327 AS i, 140737488355328 AS n, 9007199254740993 AS b, 1.5 AS r, 'é' AS t, NULL AS z, x'00ff' AS bl")))
print(type(db:value("SELECT 9007199254740993")), db:value("SELECT 9007199254740993") == bigint.new("9007199254740993"))
print(db:value("SELECT ?", true), db:value("SELECT ?", false), db:value("SELECT typeof(?)", 1.0), db:value("SELECT typeof(?)", "s"))
print(db:value("SELECT typeof(?)", sqlite.blob("ab")), db:value("SELECT length(?)", sqlite.blob(string.char(0, 1, 2))), db:value("SELECT ?", nil))
print(db:value("SELECT ? + 1", bigint.new("9223372036854775806")), db:value("SELECT typeof(?)", bigint.new("99999999999999999999")))
db:exec("UPDATE people SET photo = ? WHERE name = 'ana'", sqlite.blob(string.char(137, 80, 78, 71, 0)))
print(len(db:value("SELECT photo FROM people WHERE name = 'ana'")))
print(show(db:value("SELECT json_object('a', 1, 'b', json_array(2, 3))")), db:value("SELECT sqrt(16.0)"))

print("-- errors")
print(show(db:exec("SELECT * FROM nowhere")))
print(show(db:exec("INSERT INTO people (name) VALUES (NULL)")))
print(show(db:query("SELECT ?", 1, 2)))
print(show(db:query("SELECT :x", p)))
print(show(db:query("SELECT ?", print)))
print(show(db:exec("CREATE TABLE a (x)")))
print(show(db:exec("SELECT ?; SELECT 2", 1)))
print(show(sqlite.open("/nonexistent/dir/x.db")))
print(show(sqlite.open("/tmp/does-not-exist-sea.db", {create = false})))

print("-- prepared statements")
local st = db:prepare("SELECT name FROM people WHERE age >= :min ORDER BY name")
print(show(st.params), show(st.columns))
local m = {}
m.min = 30
print(show(st:query(m)))
m.min = 0
print(show(st:query(m)), st:value(m))
local ins = db:prepare("INSERT INTO a VALUES (?)")
for i = 10, 12 do ins:exec(i) end
print(db:value("SELECT sum(x) FROM a"), show(ins.params))
print(show(db:prepare("SELECT 1; SELECT 2")), show(db:prepare("SELEKT")))
ins:close()
print(show(ins:exec(1)))

print("-- each")
local names = []
print(db:each("SELECT name FROM people ORDER BY id", function(r)
    names[] = r.name
end), string.join(names, ","))
local seen = 0
print(db:each("SELECT x FROM a ORDER BY x", function(r)
    seen = seen + 1
    if r.x == 2 then return false end
end), seen)
print(db:each("SELECT x FROM a WHERE x > ?", function(r)
    -- the callback may use the same database
    db:exec("INSERT INTO b VALUES (?)", r.x)
end, 10), db:value("SELECT count(*) FROM b"))
print(st:each(function(r) end, m))
print(show(db:each("SELECT * FROM nowhere", function(r) end)))
print(show(db:each("SELECT 1", 5)))

print("-- transactions")
local r = db:transaction(function(tx)
    tx:exec("INSERT INTO a VALUES (100)")
    return "ok"
end)
print(r, db:value("SELECT count(*) FROM a WHERE x = 100"))
r = db:transaction(function(tx)
    tx:exec("INSERT INTO a VALUES (200)")
    return error("changed my mind")
end)
print(show(r), db:value("SELECT count(*) FROM a WHERE x = 200"))

print("-- files, connections, goroutines, backup")
local dir = fs.tempdir("sqlite-")
local path = dir .. "/data.db"
local f = sqlite.open(path, {wal = true})
f:exec("CREATE TABLE log (n INTEGER)")
local ch = chan(4)
for g = 1, 4 do
    go function()
        local c = f:connect()
        for i = 1, 25 do c:exec("INSERT INTO log VALUES (?)", g * 100 + i) end
        local count = c:value("SELECT count(*) FROM log WHERE n / 100 = ?", g)
        c:close()
        ch <- count
    end()
end
local total = 0
for g = 1, 4 do total = total + <-ch end
print(total, f:value("SELECT count(*) FROM log"), f:value("PRAGMA journal_mode"))
print(f:backup(dir .. "/copy.db"))
local copy = sqlite.open(dir .. "/copy.db", {read_only = true})
print(copy:value("SELECT count(*) FROM log"), show(copy:exec("INSERT INTO log VALUES (1)")))
copy:close()
print(show(sqlite.open():connect()))
f:close()
print(show(f:query("SELECT 1")), f:close())
db:close()
print(show(st:query(m)))
fs.remove(dir, {recursive = true})
