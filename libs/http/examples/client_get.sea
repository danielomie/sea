-- client_get.sea — HTTP GET example
-- Usage: bin/sea libs/http/examples/client_get.sea

local http = require("../http")

local url = "http://httpbin.org/get"

print("GET " .. url)

local r = http.get(url)

print("Status: " .. r.status)
print("ok: " .. tostring(r.ok))
print("--- body ---")
print(r.body)
