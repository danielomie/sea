-- server_router.sea — HTTP server usando http.router() com middleware.
--
-- Demonstra: rotas por método, parâmetros de path (:id),
-- middleware global (logger + CORS), middleware por-rota (auth),
-- grupo /admin com prefixo e auth compartilhado.
--
-- Usage:
--   bin/sea libs/http/examples/server_router.sea
--
-- Test with:
--   curl http://localhost:8080/
--   curl http://localhost:8080/ping
--   curl http://localhost:8080/users/42
--   curl -X POST -d "Alice" http://localhost:8080/users
--   curl -X DELETE http://localhost:8080/users/1           # → 401
--   curl -H "Authorization: Bearer secret" -X DELETE http://localhost:8080/users/1
--   curl http://localhost:8080/admin/stats                  # → 401
--   curl -H "Authorization: Bearer secret" http://localhost:8080/admin/stats

local http = require("../http")

local router = http.router()

-- ---- Middlewares -------------------------------------------------------

router.use(function(req, next)
    local resp = next(req)
    print(req.method .. " " .. req.path .. " " .. resp.status)
    return resp
end)

router.use(function(req, next)
    local resp = next(req)
    if not resp.headers then resp.headers = [=] end
    resp.headers["Access-Control-Allow-Origin"] = "*"
    return resp
end)

local function require_auth(req, next)
    local auth = req.headers["authorization"]
    if not auth then
        return { status=401, body="Unauthorized\n",
                 headers={ ["Content-Type"]="text/plain" } }
    end
    return next(req)
end

-- ---- Pseudo-DB ---------------------------------------------------------

local users = [=]
local next_id = 1

-- ---- Rotas -------------------------------------------------------------

router.get("/", function(req)
    return { status=200, body="Sea HTTP Router\n" }
end)

router.any("/ping", function(req)
    return { status=200, body="pong\n" }
end)

router.get("/users", function(req)
    local lines = ""
    for id, name in users do lines = lines .. id .. ": " .. name .. "\n" end
    if len(lines) == 0 then lines = "(empty)\n" end
    return { status=200, body=lines }
end)

router.post("/users", function(req)
    local id = tostring(next_id)
    next_id = next_id + 1
    users[id] = req.body
    return {
        status  = 201,
        body    = id .. "\n",
        headers = { ["Location"] = "/users/" .. id },
    }
end)

router.get("/users/:id", function(req)
    local name = users[req.params["id"]]
    if not name then return { status=404, body="not found\n" } end
    return { status=200, body=name .. "\n" }
end)

router.delete("/users/:id", { require_auth }, function(req)
    del users[req.params["id"]]
    return { status=204, body="" }
end)

-- ---- Grupo /admin (todos precisam de auth) -----------------------------

local admin = router.group("/admin", { require_auth })

admin.get("/stats", function(req)
    return { status=200, body="users: " .. len(users) .. "\n" }
end)

admin.post("/reset", function(req)
    users  = [=]
    next_id = 1
    return { status = 200, body = "reset ok\n" }
end)

-- ---- Iniciar servidor --------------------------------------------------

http.serve(8080, router)
