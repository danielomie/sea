-- writer — writing PDF files in pure Sea (pdf.new): pages with text in the
-- standard fonts (Helvetica, Courier, their bold faces: no font to embed),
-- lines and rectangles, enough for forms, invoices and barcodes
--
--   local doc = pdf.new({title, author})
--   local p = doc:page({width, height, top_down})   -- points (1/72 in); A4 by default; top_down: y from the top
--   p:text(x, y, "Ação", {font, size, align, color})    -- y: the baseline; font: helvetica | helvetica-bold |
--                                                       -- courier | courier-bold; align: left | center | right
--   p:line(x1, y1, x2, y2, {width, color, dash})
--   p:rect(x, y, w, h, {fill, stroke, width, color, fill_color})   -- (top_down: y is the top edge)
--   doc:width("text", font, size) → points;  doc:wrap(text, font, size, max_width) → [lines]
--   doc:bytes() → the file
--
-- Text is written in WinAnsi (Windows-1252): Portuguese and the other
-- Western European languages; a character outside it becomes "?". The
-- widths are the standard fonts' (Courier: 600 per 1000), so measuring and
-- aligning match what a reader shows. Content streams are compressed
-- (libs/compress). Colors: {r, g, b} from 0 to 1, or a gray number.

local M = {}

local compress = require("../compress/compress")

M.A4 = {width = 595.28, height = 841.89}

-- the widths of the characters 32..255 in WinAnsi, per 1000 units of the size
local W = {}
W.helvetica = [278, 278, 355, 556, 556, 889, 667, 191, 333, 333, 389, 584, 278, 333, 278, 278, 556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 278, 278, 584, 584, 584, 556, 1015, 667, 667, 722, 722, 667, 611, 778, 722, 278, 500, 667, 556, 833, 722, 778, 667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 278, 278, 278, 469, 556, 333, 556, 556, 500, 556, 556, 278, 556, 556, 222, 222, 500, 222, 833, 556, 556, 556, 556, 333, 500, 278, 556, 500, 722, 500, 500, 500, 334, 260, 334, 584, 750, 556, 278, 222, 556, 333, 1000, 556, 556, 333, 1000, 667, 333, 1000, 278, 611, 278, 278, 222, 222, 333, 333, 350, 556, 1000, 333, 1000, 500, 333, 944, 278, 500, 667, 278, 333, 556, 556, 556, 556, 260, 556, 333, 737, 370, 556, 584, 333, 737, 552, 400, 549, 333, 333, 333, 576, 537, 333, 333, 333, 365, 556, 834, 834, 834, 611, 667, 667, 667, 667, 667, 667, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278, 722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611, 556, 556, 556, 556, 556, 556, 889, 500, 556, 556, 556, 556, 278, 278, 278, 278, 556, 556, 556, 556, 556, 556, 556, 549, 611, 556, 556, 556, 556, 500, 556, 500]
W.helvetica_bold = [278, 333, 474, 556, 556, 889, 722, 238, 333, 333, 389, 584, 278, 333, 278, 278, 556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 333, 333, 584, 584, 584, 611, 975, 722, 722, 722, 722, 667, 611, 778, 722, 278, 556, 722, 611, 833, 722, 778, 667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 333, 278, 333, 584, 556, 333, 556, 611, 556, 611, 556, 333, 611, 611, 278, 278, 556, 278, 889, 611, 611, 611, 611, 389, 556, 333, 611, 556, 778, 556, 556, 500, 389, 280, 389, 584, 750, 556, 278, 278, 556, 500, 1000, 556, 556, 333, 1000, 667, 333, 1000, 278, 611, 278, 278, 278, 278, 500, 500, 350, 556, 1000, 333, 1000, 556, 333, 944, 278, 500, 667, 278, 333, 556, 556, 556, 556, 280, 556, 333, 737, 370, 556, 584, 333, 737, 552, 400, 549, 333, 333, 333, 576, 556, 333, 333, 333, 365, 556, 834, 834, 834, 611, 722, 722, 722, 722, 722, 722, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278, 722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611, 556, 556, 556, 556, 556, 556, 889, 556, 556, 556, 556, 556, 278, 278, 278, 278, 611, 611, 611, 611, 611, 611, 611, 549, 611, 611, 611, 611, 611, 556, 611, 556]

local FONTS = {
    helvetica = {ref = "F1", base = "Helvetica", widths = W.helvetica},
    ["helvetica-bold"] = {ref = "F2", base = "Helvetica-Bold", widths = W.helvetica_bold},
    courier = {ref = "F3", base = "Courier"},
    ["courier-bold"] = {ref = "F4", base = "Courier-Bold"},
}
local FONT_ORDER = ["helvetica", "helvetica-bold", "courier", "courier-bold"]

-- Windows-1252's 128..159
local CP1252 = {[0x20AC] = 128, [0x201A] = 130, [0x0192] = 131, [0x201E] = 132, [0x2026] = 133, [0x2020] = 134,
    [0x2021] = 135, [0x02C6] = 136, [0x2030] = 137, [0x0160] = 138, [0x2039] = 139, [0x0152] = 140, [0x017D] = 142,
    [0x2018] = 145, [0x2019] = 146, [0x201C] = 147, [0x201D] = 148, [0x2022] = 149, [0x2013] = 150, [0x2014] = 151,
    [0x02DC] = 152, [0x2122] = 153, [0x0161] = 154, [0x203A] = 155, [0x0153] = 156, [0x017E] = 158, [0x0178] = 159}

-- UTF-8 → the WinAnsi bytes
local function winansi(s)
    local out = []
    for _, cp in utf8.codepoints(tostring(s)) do
        if cp == 9 then cp = 32 end
        if cp >= 32 and cp < 127 or cp >= 160 and cp <= 255 then
            out[] = string.char(cp)
        elseif CP1252[cp] ~= nil then
            out[] = string.char(CP1252[cp])
        elseif cp >= 32 then
            out[] = "?"
        end
    end
    return string.join(out, "")
end

local function pdf_string(bytes)
    local s = string.replace(bytes, "\\", "\\\\")
    s = string.replace(s, "(", "\\(")
    s = string.replace(s, ")", "\\)")
    return "(" .. s .. ")"
end

local function num(v)
    local s = string.format("%.3f", v)
    s = re.gsub("0+$", s, "")
    s = re.gsub("\\.$", s, "")
    if s == "-0" then s = "0" end
    return s
end

local function color(c, stroke)
    if c == nil then return nil end
    if type(c) == "number" or type(c) == "int" then return num(c) .. (stroke and " G" or " g") end
    return num(c[0] or c.r or 0) .. " " .. num(c[1] or c.g or 0) .. " " .. num(c[2] or c.b or 0) .. (stroke and " RG" or " rg")
end

local function width_of(bytes, font, size)
    local f = FONTS[font or "helvetica"] or FONTS.helvetica
    if f.widths == nil then return len(bytes) * 600 * size / 1000 end
    local w = 0
    for i = 1, len(bytes) do
        local b = string.byte(bytes, i)
        w += f.widths[b - 32] or 556
    end
    return w * size / 1000
end

local Doc = {}
local Page = {}

-- pdf.new([info]) → document
function M.new(info)
    local d = {}
    d.info = info or {}
    d.pages = []
    for k, f in Doc do d[k] = f end
    return d
end

function Doc.page(d, o)
    o = o or {}
    local p = {}
    p.width = o.width or M.A4.width
    p.height = o.height or M.A4.height
    p.top_down = o.top_down == true
    p.ops = []
    for k, f in Page do p[k] = f end
    d.pages[] = p
    return p
end

function Doc.width(d, text, font, size)
    return width_of(winansi(text), font, size or 10)
end

-- the text in lines no wider than max_width (words kept whole when they fit)
function Doc.wrap(d, text, font, size, max_width)
    local lines = []
    for _, para in string.split(tostring(text), "\n") do
        local line = ""
        for _, word in string.split(para, " ") do
            local try = line == "" and word or (line .. " " .. word)
            if line ~= "" and d:width(try, font, size) > max_width then
                lines[] = line
                line = word
            else
                line = try
            end
        end
        lines[] = line
    end
    return lines
end

local function y_of(p, y)
    return p.top_down and (p.height - y) or y
end

function Page.text(p, x, y, text, o)
    o = o or {}
    local font = o.font or "helvetica"
    local f = FONTS[font] or FONTS.helvetica
    local size = o.size or 10
    local bytes = winansi(text)
    if bytes == "" then return end
    local tx = x
    if o.align == "center" then tx = x - width_of(bytes, font, size) / 2
    elseif o.align == "right" then tx = x - width_of(bytes, font, size) end
    local c = color(o.color, false)
    p.ops[] = "BT " .. (c and (c .. " ") or "") .. "/" .. f.ref .. " " .. num(size) .. " Tf " .. num(tx) .. " " ..
        num(y_of(p, y)) .. " Td " .. pdf_string(bytes) .. " Tj ET" .. (c and " 0 g" or "")
end

function Page.line(p, x1, y1, x2, y2, o)
    o = o or {}
    local parts = ["q"]
    parts[] = num(o.width or 0.5) .. " w"
    if o.color ~= nil then parts[] = color(o.color, true) end
    if o.dash ~= nil then parts[] = "[" .. num(o.dash) .. "] 0 d" end
    parts[] = num(x1) .. " " .. num(y_of(p, y1)) .. " m " .. num(x2) .. " " .. num(y_of(p, y2)) .. " l S Q"
    p.ops[] = string.join(parts, " ")
end

function Page.rect(p, x, y, w, h, o)
    o = o or {}
    local by = p.top_down and (p.height - y - h) or y
    local fill = o.fill == true or o.fill_color ~= nil
    local stroke = o.stroke ~= false and not (fill and o.stroke == nil)
    local parts = ["q"]
    parts[] = num(o.width or 0.5) .. " w"
    if o.color ~= nil then parts[] = color(o.color, true) end
    if fill then parts[] = color(o.fill_color or o.color or 0, false) end
    parts[] = num(x) .. " " .. num(by) .. " " .. num(w) .. " " .. num(h) .. " re " ..
        ((fill and stroke) and "B" or (fill and "f" or "S")) .. " Q"
    p.ops[] = string.join(parts, " ")
end

-- the file: catalog, pages, the four fonts, each page's content, info, the cross-reference table
function Doc.bytes(d)
    local objs = []           -- object n at objs[n - 1]
    local function add(body)
        objs[] = body
        return len(objs)
    end
    local catalog = add("")
    local pages = add("")
    local font_ids = {}
    for _, name in FONT_ORDER do
        font_ids[name] = add(`<< /Type /Font /Subtype /Type1 /BaseFont /${FONTS[name].base} /Encoding /WinAnsiEncoding >>`)
    end
    local fonts = []
    for _, name in FONT_ORDER do fonts[] = `/${FONTS[name].ref} ${font_ids[name]} 0 R` end
    local resources = "<< /Font << " .. string.join(fonts, " ") .. " >> >>"
    local kids = []
    for _, p in d.pages do
        local content = string.join(p.ops, "\n")
        local stream = nil
        if len(content) > 200 then
            local z = compress.deflate(content)
            stream = `<< /Length ${len(z)} /Filter /FlateDecode >>\nstream\n${z}\nendstream`
        else
            stream = `<< /Length ${len(content)} >>\nstream\n${content}\nendstream`
        end
        local cid = add(stream)
        kids[] = add(`<< /Type /Page /Parent ${pages} 0 R /MediaBox [0 0 ${num(p.width)} ${num(p.height)}] ` ..
            `/Resources ${resources} /Contents ${cid} 0 R >>`)
    end
    objs[catalog - 1] = `<< /Type /Catalog /Pages ${pages} 0 R >>`
    objs[pages - 1] = `<< /Type /Pages /Kids [${string.join(list.map(kids, function(k) return k .. " 0 R" end), " ")}] ` ..
        `/Count ${len(kids)} >>`
    local info_parts = ["/Producer " .. pdf_string(winansi(d.info.producer or "Sea pdf"))]
    if d.info.title ~= nil then info_parts[] = "/Title " .. pdf_string(winansi(d.info.title)) end
    if d.info.author ~= nil then info_parts[] = "/Author " .. pdf_string(winansi(d.info.author)) end
    local info = add("<< " .. string.join(info_parts, " ") .. " >>")
    local out = ["%PDF-1.4\n%\xE2\xE3\xCF\xD3\n"]
    local offset = len(out[0])
    local offsets = []
    for i, body in objs do
        offsets[] = offset
        local piece = `${i + 1} 0 obj\n${body}\nendobj\n`
        out[] = piece
        offset += len(piece)
    end
    local xref = [`xref\n0 ${len(objs) + 1}\n0000000000 65535 f \n`]
    for _, o in offsets do xref[] = string.format("%010d 00000 n \n", o) end
    out[] = string.join(xref, "")
    out[] = `trailer\n<< /Size ${len(objs) + 1} /Root ${catalog} 0 R /Info ${info} 0 R >>\nstartxref\n${offset}\n%%EOF\n`
    return string.join(out, "")
end

return M
